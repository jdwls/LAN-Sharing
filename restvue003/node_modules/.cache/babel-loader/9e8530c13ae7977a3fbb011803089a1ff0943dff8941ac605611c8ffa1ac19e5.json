{"ast":null,"code":"import { createTextVNode as _createTextVNode, resolveComponent as _resolveComponent, withCtx as _withCtx, createVNode as _createVNode, openBlock as _openBlock, createElementBlock as _createElementBlock } from \"vue\";\nexport function render(_ctx, _cache, $props, $setup, $data, $options) {\n  const _component_el_button = _resolveComponent(\"el-button\");\n  return _openBlock(), _createElementBlock(\"div\", null, [_createVNode(_component_el_button, {\n    onClick: _cache[0] || (_cache[0] = $event => $options.downloadFlie($props.down))\n  }, {\n    default: _withCtx(() => [_createTextVNode(\"下载文件\")]),\n    _: 1 /* STABLE */\n  })]);\n}","map":{"version":3,"names":["_createElementBlock","_createVNode","_component_el_button","onClick","_cache","$event","$options","downloadFlie","$props","down","default","_withCtx","_createTextVNode","_"],"sources":["C:\\Users\\administered\\Desktop\\code\\restvue003\\src\\components\\LanShare\\LanShareIndexButton\\downloadFlie.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <el-button @click=\"downloadFlie(down)\">下载文件</el-button>\r\n  </div>\r\n</template>\r\n<script>\r\nimport axios from 'axios';\r\n\r\nexport default {\r\n  name: \"downloadFlie\",\r\n  props: [\"down\"],\r\n  data() {\r\n    return {\r\n      url: \"\",\r\n    };\r\n  },\r\n  methods: {\r\n    downloadFlie(s) {\r\n      let url =\r\n        this.$store.state.api +\r\n        \"/download?downloadPathName=\" +\r\n        this.$store.state.DirPath +\r\n        \"/\" +\r\n        s +\r\n        \"&downloadName=\" +\r\n        s;\r\n      // window.location.href = url;  \r\n      axios({\r\n        url: url,\r\n        method: \"get\",\r\n        responseType: \"blob\",\r\n      })\r\n        .then((response) => {\r\n          const blob = new Blob([response.data]);\r\n          // 创建下载链接\r\n          const downloadUrl = window.URL.createObjectURL(blob);\r\n          const link = document.createElement('a');\r\n          link.href = downloadUrl;\r\n          // 从响应头获取文件名，如果不可用则使用prop传入的文件名\r\n          const contentDisposition = response.headers['content-disposition'];\r\n          let downloadFilename = this.down;\r\n\r\n          if (contentDisposition) {\r\n            const filenameMatch = contentDisposition.match(/filename=\"?(.+)\"?/);\r\n            if (filenameMatch && filenameMatch[1]) {\r\n              downloadFilename = filenameMatch[1];\r\n            }\r\n          }\r\n\r\n          link.setAttribute('download', downloadFilename);\r\n          document.body.appendChild(link);\r\n\r\n          // 触发下载\r\n          link.click();\r\n\r\n          // 清理\r\n          link.remove();\r\n          window.URL.revokeObjectURL(downloadUrl);\r\n\r\n          // 可以在这里添加成功回调或通知用户\r\n          // this.$message.success('文件下载成功');\r\n          console.log(1);\r\n          \r\n        })\r\n        .catch((err) => {\r\n          console.log(err);\r\n\r\n        })\r\n    },\r\n  },\r\n};\r\n</script>\r\n"],"mappings":";;;uBACEA,mBAAA,CAEM,cADJC,YAAA,CAAuDC,oBAAA;IAA3CC,OAAK,EAAAC,MAAA,QAAAA,MAAA,MAAAC,MAAA,IAAEC,QAAA,CAAAC,YAAY,CAACC,MAAA,CAAAC,IAAI;;IAFxCC,OAAA,EAAAC,QAAA,CAE2C,MAAI,CAF/CC,gBAAA,CAE2C,MAAI,E;IAF/CC,CAAA"},"metadata":{},"sourceType":"module","externalDependencies":[]}