{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport axios from 'axios';\nimport { seend_message_Files_fun } from \"@/socke/index.js\";\nexport default {\n  name: 'Chat_Room_File_Updata',\n  methods: {\n    Chat_Room_File_Updata_uploadFile_fun() {\n      const fileIput = this.$refs.Chat_Room_File_Updata_input_ref;\n      fileIput.click();\n    },\n    Chat_Room_File_Updata_input_handleFileUpload() {\n      const fileIput = this.$refs.Chat_Room_File_Updata_input_ref;\n      const file = fileIput.files;\n      const uploadPromises = [];\n      console.log(1);\n      if (file) {\n        for (let i = 0; i < file.length; i++) {\n          const formData = new FormData();\n          console.log(file[i]);\n          formData.append('file', file[i]);\n          formData.append('FileInput', file[i]); // 字段名与后端一致\n          formData.append('file_name', file[i].name);\n          formData.append('file_type', file[i].type);\n          formData.append('send_name', localStorage.getItem('UresName'));\n          formData.append('report_name', this.$store.state.currentChat);\n          uploadPromises.push(axios({\n            url: this.$store.state.api + '/Chat_Room_File_Updata_api',\n            method: 'post',\n            data: formData,\n            headers: {\n              'Content-Type': 'multipart/form-data'\n            }\n          }));\n        }\n\n        // 使用Promise.all等待所有文件上传完成\n        Promise.all(uploadPromises).then(responses => {\n          responses.forEach((res, index) => {\n            if (res.data.ms === '文件上传成功') {\n              seend_message_Files_fun(file[index].name, this.$store.state.currentChat, file[index].type);\n            }\n          });\n        }).catch(err => {\n          console.error('文件上传出错:', err);\n        });\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","seend_message_Files_fun","name","methods","Chat_Room_File_Updata_uploadFile_fun","fileIput","$refs","Chat_Room_File_Updata_input_ref","click","Chat_Room_File_Updata_input_handleFileUpload","file","files","uploadPromises","console","log","i","length","formData","FormData","append","type","localStorage","getItem","$store","state","currentChat","push","url","api","method","data","headers","Promise","all","then","responses","forEach","res","index","ms","catch","err","error"],"sources":["C:\\Users\\administered\\Desktop\\code\\restvue003\\src\\components\\ChatRoom\\Chat_Room_infomation\\Chat_Room_File_Updata.vue"],"sourcesContent":["<template>\r\n    <div>\r\n        <div class=\"chat-room-file-updata\">\r\n            <svg t=\"1754017969599\" class=\"icon\" viewBox=\"0 0 1024 1024\" version=\"1.1\" p-id=\"1548\" width=\"40\" height=\"40\"\r\n                @click=\"Chat_Room_File_Updata_uploadFile_fun()\">\r\n                <path\r\n                    d=\"M371.2 455.111111L483.555556 343.893333v262.826667a28.444444 28.444444 0 1 0 56.888888 0v-262.826667L652.8 455.111111a28.444444 28.444444 0 0 0 40.106667-40.106667L532.195556 256a28.444444 28.444444 0 0 0-40.106667 0l-160.995556 160.995556A28.444444 28.444444 0 0 0 371.2 455.111111zM739.555556 663.608889a28.444444 28.444444 0 0 0-28.444445 28.444444v28.444445H312.888889v-28.444445a28.444444 28.444444 0 0 0-56.888889 0v56.888889a28.444444 28.444444 0 0 0 28.444444 28.444445h455.111112a28.444444 28.444444 0 0 0 28.444444-28.444445v-56.888889a28.444444 28.444444 0 0 0-28.444444-28.444444z\"\r\n                    p-id=\"1549\"></path>\r\n            </svg>\r\n            <input type=\"file\" @change=\"Chat_Room_File_Updata_input_handleFileUpload()\" v-show=\"false\"\r\n                ref=\"Chat_Room_File_Updata_input_ref\" multiple\r\n                accept=\".jpg,.jpeg,.png,.gif,.bmp,.webp,.svg,.mp4,.webm,.ogg,.apng,.avif,.bmp,.quicktime,.x-matroska,.mpeg\" />\r\n        </div>\r\n    </div>\r\n\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\n\r\nimport { seend_message_Files_fun } from \"@/socke/index.js\";\r\n\r\nexport default {\r\n    name: 'Chat_Room_File_Updata',\r\n    methods: {\r\n        Chat_Room_File_Updata_uploadFile_fun() {\r\n            const fileIput = this.$refs.Chat_Room_File_Updata_input_ref\r\n            fileIput.click();\r\n        },\r\n        Chat_Room_File_Updata_input_handleFileUpload() {\r\n            const fileIput = this.$refs.Chat_Room_File_Updata_input_ref\r\n            const file = fileIput.files;\r\n            const uploadPromises = [];\r\n            console.log(1);\r\n            if (file) {\r\n                for (let i = 0; i < file.length; i++) {\r\n                    const formData = new FormData()\r\n                    console.log(file[i]);\r\n                    formData.append('file', file[i]);\r\n                    formData.append('FileInput', file[i]);  // 字段名与后端一致\r\n                    formData.append('file_name', file[i].name);\r\n                    formData.append('file_type', file[i].type);\r\n                    formData.append('send_name', localStorage.getItem('UresName'));\r\n                    formData.append('report_name', this.$store.state.currentChat);\r\n                    uploadPromises.push(\r\n                        axios({\r\n                            url: this.$store.state.api + '/Chat_Room_File_Updata_api',\r\n                            method: 'post',\r\n                            data: formData,\r\n                            headers: {\r\n                                'Content-Type': 'multipart/form-data'\r\n                            }\r\n                        })\r\n                    );\r\n                }\r\n\r\n                // 使用Promise.all等待所有文件上传完成\r\n                Promise.all(uploadPromises)\r\n                    .then(responses => {\r\n                        responses.forEach((res, index) => {\r\n                            if (res.data.ms === '文件上传成功') {\r\n                                seend_message_Files_fun(\r\n                                    file[index].name,\r\n                                    this.$store.state.currentChat,\r\n                                    file[index].type\r\n                                );\r\n                            }\r\n                        });\r\n                    })\r\n                    .catch(err => {\r\n                        console.error('文件上传出错:', err);\r\n                    });\r\n            }\r\n        }\r\n    }\r\n\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.icon {\r\n    cursor: pointer;\r\n}\r\n\r\n.icon:hover {\r\n    background-color: azure;\r\n}\r\n</style>"],"mappings":";AAkBA,OAAOA,KAAI,MAAO,OAAO;AAEzB,SAASC,uBAAsB,QAAS,kBAAkB;AAE1D,eAAe;EACXC,IAAI,EAAE,uBAAuB;EAC7BC,OAAO,EAAE;IACLC,oCAAoCA,CAAA,EAAG;MACnC,MAAMC,QAAO,GAAI,IAAI,CAACC,KAAK,CAACC,+BAA8B;MAC1DF,QAAQ,CAACG,KAAK,CAAC,CAAC;IACpB,CAAC;IACDC,4CAA4CA,CAAA,EAAG;MAC3C,MAAMJ,QAAO,GAAI,IAAI,CAACC,KAAK,CAACC,+BAA8B;MAC1D,MAAMG,IAAG,GAAIL,QAAQ,CAACM,KAAK;MAC3B,MAAMC,cAAa,GAAI,EAAE;MACzBC,OAAO,CAACC,GAAG,CAAC,CAAC,CAAC;MACd,IAAIJ,IAAI,EAAE;QACN,KAAK,IAAIK,CAAA,GAAI,CAAC,EAAEA,CAAA,GAAIL,IAAI,CAACM,MAAM,EAAED,CAAC,EAAE,EAAE;UAClC,MAAME,QAAO,GAAI,IAAIC,QAAQ,CAAC;UAC9BL,OAAO,CAACC,GAAG,CAACJ,IAAI,CAACK,CAAC,CAAC,CAAC;UACpBE,QAAQ,CAACE,MAAM,CAAC,MAAM,EAAET,IAAI,CAACK,CAAC,CAAC,CAAC;UAChCE,QAAQ,CAACE,MAAM,CAAC,WAAW,EAAET,IAAI,CAACK,CAAC,CAAC,CAAC,EAAG;UACxCE,QAAQ,CAACE,MAAM,CAAC,WAAW,EAAET,IAAI,CAACK,CAAC,CAAC,CAACb,IAAI,CAAC;UAC1Ce,QAAQ,CAACE,MAAM,CAAC,WAAW,EAAET,IAAI,CAACK,CAAC,CAAC,CAACK,IAAI,CAAC;UAC1CH,QAAQ,CAACE,MAAM,CAAC,WAAW,EAAEE,YAAY,CAACC,OAAO,CAAC,UAAU,CAAC,CAAC;UAC9DL,QAAQ,CAACE,MAAM,CAAC,aAAa,EAAE,IAAI,CAACI,MAAM,CAACC,KAAK,CAACC,WAAW,CAAC;UAC7Db,cAAc,CAACc,IAAI,CACf1B,KAAK,CAAC;YACF2B,GAAG,EAAE,IAAI,CAACJ,MAAM,CAACC,KAAK,CAACI,GAAE,GAAI,4BAA4B;YACzDC,MAAM,EAAE,MAAM;YACdC,IAAI,EAAEb,QAAQ;YACdc,OAAO,EAAE;cACL,cAAc,EAAE;YACpB;UACJ,CAAC,CACL,CAAC;QACL;;QAEA;QACAC,OAAO,CAACC,GAAG,CAACrB,cAAc,EACrBsB,IAAI,CAACC,SAAQ,IAAK;UACfA,SAAS,CAACC,OAAO,CAAC,CAACC,GAAG,EAAEC,KAAK,KAAK;YAC9B,IAAID,GAAG,CAACP,IAAI,CAACS,EAAC,KAAM,QAAQ,EAAE;cAC1BtC,uBA