{"ast":null,"code":"import axios from \"axios\";\nexport default {\n  name: \"dropFiles\",\n  props: [\"dropFiles\"],\n  methods: {\n    async dropFile(dropFiles) {\n      // let button = document.getElementById(\"myButton\");\n      // button.setAttribute(\"disabled\", false);\n      axios({\n        url: this.$store.state.api + \"/dropFiles\",\n        method: \"get\",\n        params: {\n          dropFilesName: this.$store.state.DirPath + \"/\" + dropFiles\n        }\n      }).then(res => {\n        if (res.data.type == \"删除文件成功\") {\n          this.$store.dispatch(\"DirsFileList\");\n        }\n      }).catch(err => {\n        console.log(err);\n      });\n    }\n  }\n};","map":{"version":3,"names":["axios","name","props","methods","dropFile","dropFiles","url","$store","state","api","method","params","dropFilesName","DirPath","then","res","data","type","dispatch","catch","err","console","log"],"sources":["F:\\Windows\\Desktop\\code\\restvue003\\src\\components\\dropFiles.vue"],"sourcesContent":["<template>\n  <div>\n    <el-button @click=\"dropFile(dropFiles)\" id=\"myButton\"> 删除文件</el-button>\n  </div>\n</template>\n\n<script>\nimport axios from \"axios\";\n\nexport default {\n  name: \"dropFiles\",\n\n  props: [\"dropFiles\"],\n  methods: {\n  async  dropFile(dropFiles) {\n      // let button = document.getElementById(\"myButton\");\n      // button.setAttribute(\"disabled\", false);\n      axios({\n        url: this.$store.state.api + \"/dropFiles\",\n        method: \"get\",\n        params: {\n          dropFilesName: this.$store.state.DirPath + \"/\" + dropFiles,\n        },\n      }).then((res) => {\n        if (res.data.type == \"删除文件成功\") {\n        this.$store.dispatch(\"DirsFileList\");\n        }\n      })\n      .catch((err) => {\n        console.log(err);\n      });\n      \n    },\n  },\n};\n</script>\n<style scoped></style>\n"],"mappings":"AAOA,OAAOA,KAAI,MAAO,OAAO;AAEzB,eAAe;EACbC,IAAI,EAAE,WAAW;EAEjBC,KAAK,EAAE,CAAC,WAAW,CAAC;EACpBC,OAAO,EAAE