{"ast":null,"code":"import UrseLIst from \"@/components/ChatRoom/UrseLIst/UrseLIst.vue\";\nimport Chat_Room_infomation_view from \"@/components/ChatRoom/ChatRoomIndex.vue\";\nimport { sendMessage } from \"@/socke/index.js\";\nexport default {\n  name: \"ChatRoomIndex\",\n  components: {\n    UrseLIst,\n    Chat_Room_infomation_view\n  },\n  data() {\n    return {\n      message: \"\",\n      currentChat: null\n    };\n  },\n  methods: {\n    startChat(user) {\n      this.currentChat = user;\n    },\n    sendMessage() {\n      if (this.message.trim()) {\n        sendMessage(this.message, this.currentChat);\n        this.message = \"\";\n      }\n    }\n  },\n  computed: {\n    userStatus() {\n      if (!this.currentChat) return {\n        type: 'info',\n        text: '未知'\n      };\n      const isOnline = this.$store.state.Online_Numbers.includes(this.currentChat);\n      return {\n        type: isOnline ? 'success' : 'info',\n        text: isOnline ? '在线' : '离线'\n      };\n    }\n  },\n  mounted() {\n    this.$store.dispatch(\"Tokers\");\n    // sendReport(this.currentChat)\n  }\n};","map":{"version":3,"names":["UrseLIst","Chat_Room_infomation_view","sendMessage","name","components","data","message","currentChat","methods","startChat","user","trim","computed","userStatus","type","text","isOnline","$store","state","Online_Numbers","includes","mounted","dispatch"],"sources":["C:\\Users\\administered\\Desktop\\code\\restvue003\\src\\components\\ChatRoom\\ChatRoomIndex.vue"],"sourcesContent":["<template>\r\n  <div class=\"chat-room-container\">\r\n    <div class=\"sidebar\">\r\n      <UrseLIst @user-selected=\"startChat\" />\r\n    </div>\r\n    <div class=\"main-content\">\r\n      <Chat_Room_infomation_view></Chat_Room_infomation_view>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport UrseLIst from \"@/components/ChatRoom/UrseLIst/UrseLIst.vue\";\r\nimport Chat_Room_infomation_view from \"@/components/ChatRoom/ChatRoomIndex.vue\"\r\nimport {sendMessage} from \"@/socke/index.js\";\r\nexport default {\r\n  name: \"ChatRoomIndex\",\r\n  components: {\r\n    UrseLIst,Chat_Room_infomation_view\r\n  },\r\n  data() {\r\n    return {\r\n      message: \"\",\r\n      currentChat: null,\r\n    };\r\n  },\r\n  methods: {\r\n    startChat(user) {\r\n      this.currentChat = user;\r\n    },\r\n    sendMessage() {\r\n      if (this.message.trim()) {\r\n        sendMessage(this.message,this.currentChat)\r\n        this.message = \"\";\r\n      }\r\n     \r\n    },\r\n  },\r\n  computed: {\r\n    userStatus() {\r\n      if (!this.currentChat) return { type: 'info', text: '未知' };\r\n      const isOnline = this.$store.state.Online_Numbers.includes(this.currentChat);\r\n      return {\r\n        type: isOnline ? 'success' : 'info',\r\n        text: isOnline ? '在线' : '离线'\r\n      };\r\n    },\r\n  },\r\n  mounted() {\r\n    this.$store.dispatch(\"Tokers\");\r\n    // sendReport(this.currentChat)\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.el-input {\r\n  height: 6vh;\r\n  background: #f0f8ff;\r\n}\r\n\r\n.chat-room-container {\r\n  display: flex;\r\n  /* height:100%; */\r\n  background-color: #f5f7fa;\r\n}\r\n\r\n.sidebar {\r\n  width: 300px;\r\n  border-right: 1px solid #e2e5ec;\r\n  background: #f0f8ff;\r\n}\r\n\r\n.main-content {\r\n  flex: 1;\r\n  display: flex;\r\n  flex-direction: column;\r\n  margin-top: 2vh;\r\n}\r\n.chat-header {\r\n  padding: 15px 0;\r\n  background: #fff;\r\n  position: sticky;\r\n  top: 0;\r\n  z-index: 1;\r\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);\r\n  border-radius: 10px;\r\n}\r\n\r\n.message-input {\r\n width: 70vw;\r\n margin-top: 3vh;\r\n}\r\n\r\n.chat-bgcolor {\r\n  width: 70vw;\r\n  height: 67vh;\r\n  background-color: #ffffff;\r\n  overflow-y: hidden;\r\n  margin-top: 3vh;\r\n  border-radius: 10px;\r\n}\r\n</style>\r\n"],"mappings":"AAYA,OAAOA,QAAO,MAAO,6CAA6C;AAClE,OAAOC,yBAAwB,MAAO,yCAAwC;AAC9E,SAAQC,WAAW,QAAO,kBAAkB;AAC5C,eAAe;EACbC,IAAI,EAAE,eAAe;EACrBC,UAAU,EAAE;IACVJ,QAAQ;IA