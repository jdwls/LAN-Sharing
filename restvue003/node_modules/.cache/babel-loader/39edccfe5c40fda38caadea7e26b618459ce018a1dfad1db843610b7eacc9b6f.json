{"ast":null,"code":"import { io } from \"socket.io-client\";\nexport default {\n  name: \"IsOlineNumber\",\n  mounted() {\n    const socket = io(this.$store.state.api, {\n      autoConnect: false\n    });\n    socket.on(\"connect\", () => {\n      console.log(\"Connected to the server\");\n    });\n    socket.emit(\"Toker\", localStorage.getItem(\"UresName\"));\n  },\n  beforeUnmount() {\n    const socket = io(this.$store.state.api);\n    socket.disconnect();\n  }\n};","map":{"version":3,"names":["io","name","mounted","socket","$store","state","api","autoConnect","on","console","log","emit","localStorage","getItem","beforeUnmount","disconnect"],"sources":["F:\\Windows\\Desktop\\code\\restvue003\\src\\components\\ChatRoom\\UrseLIst\\IsOlineNumber.vue"],"sourcesContent":["<template>\n  <div>11</div>\n</template>\n\n<script>\nimport { io } from \"socket.io-client\";\nexport default {\n  name: \"IsOlineNumber\",\n  mounted() {\n    const socket = io(this.$store.state.api, {\n      autoConnect: false,\n    });\n    socket.on(\"connect\", () => {\n      console.log(\"Connected to the server\");\n    });\n    socket.emit(\"Toker\", localStorage.getItem(\"UresName\"));\n  },\n  beforeUnmount() {\n    const socket = io(this.$store.state.api);\n    socket.disconnect();\n  },\n};\n</script>\n"],"mappings":"AAKA,SAASA,EAAC,QAAS,kBAAkB;AACrC,eAAe;EACbC,IAAI,EAAE,eAAe;EACrBC,OAAOA,CAAA,EAAG;IACR,MAAMC,MAAK,GAAIH,EAAE,CAAC,IAAI,CAACI,MAAM,CAACC,KAAK,CAACC,GAAG,EAAE;MACvCC,WAAW,EAAE;IACf,CAAC,CAAC;IACFJ,MAAM,CAACK,EAAE,CAAC,SAAS,EAAE,MAAM;MACzBC,OAAO,CAACC,GAAG,CAAC,yBAAyB,CAAC;IACxC,CAAC,CAAC;IACFP,MAAM,CAACQ,IAAI,CAAC,OAAO,EAAEC,YAAY,CAACC,OAAO,CAAC,UAAU,CAAC,CAAC;EACxD,CAAC;EACDC,aAAaA,CAAA,EAAG;IACd,MAAMX,MAAK,GAAIH,EAAE,CAAC,IAAI,CAACI,MAAM,CAACC,KAAK,CAACC,GAAG,CAAC;IACxCH,MAAM,CAACY,UAAU,CAAC,CAAC;EACrB;AACF,CAAC"},"metadata":{},"sourceType":"module","externalDependencies":[]}