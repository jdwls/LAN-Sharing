{"ast":null,"code":"import { seend_message_fun } from \"@/socke/index.js\";\nexport default {\n  name: 'Chat_Room_infomation_view',\n  data() {\n    return {\n      message: \"\"\n    };\n  },\n  computed: {\n    userStatus() {\n      if (!this.$store.state.currentChat) return {\n        type: 'info',\n        text: '未知'\n      };\n      const isOnline = this.$store.state.Online_Numbers.includes(this.$store.state.currentChat);\n      return {\n        type: isOnline ? 'success' : 'info',\n        text: isOnline ? '在线' : '离线'\n      };\n    }\n  },\n  methods: {\n    sendMessage() {\n      seend_message_fun(this.message, this.$store.state.currentChat);\n      this.message = \"\";\n    }\n  }\n};","map":{"version":3,"names":["seend_message_fun","name","data","message","computed","userStatus","$store","state","currentChat","type","text","isOnline","Online_Numbers","includes","methods","sendMessage"],"sources":["C:\\Users\\administered\\Desktop\\code\\restvue003\\src\\components\\ChatRoom\\Chat_Room_infomation\\Chat_Room_infomation_view.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <div class=\"chat-header\">\r\n      <el-row align=\"middle\" :gutter=\"20\">\r\n        <el-col :span=\"3\">\r\n          <el-avatar :size=\"60\" src=\"https://cube.elemecdn.com/0/88/03b0d39583f48206768a7534e55bcpng.png\" />\r\n        </el-col>\r\n        <el-col :span=\"21\">\r\n          <h2 style=\"margin:0 0 5px 0;font-weight:600;color:#303133\">与 {{ $store.state.currentChat }} 的对话</h2>\r\n          <p style=\"margin:0;font-size:14px;color:#909399\">\r\n            <el-tag size=\"small\" :type=\"userStatus.type\">{{ userStatus.text }}</el-tag>\r\n          </p>\r\n        </el-col>\r\n      </el-row>\r\n      <el-divider style=\"margin:15px 0\" />\r\n    </div>\r\n    <div class=\"chat-bgcolor\">\r\n      <div v-for=\"msg in $store.state.messages_lists\" :key=\"msg.id\" class=\"message-item\"\r\n        :class=\"{ 'current-user': msg.current_usrs }\">\r\n        <div ><el-avatar class=\"avatars\"  :class=\"{ 'current-user': msg.current_usrs }\" src=\"https://cube.elemecdn.com/0/88/03b0d39583f48206768a7534e55bcpng.png\" /></div>\r\n        <div class=\"message-content\">\r\n          <div class=\"message-text\">{{ msg.message }}</div>\r\n          <div class=\"message-time\">{{ new Date(msg.Time * 1000).toLocaleTimeString() }}</div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n    <div class=\"message-input\">\r\n      <el-input placeholder=\"输入消息...\" v-model=\"message\"  @keyup.enter=\"sendMessage\" >\r\n        <template #append>\r\n          <el-button  @click=\"sendMessage\">发送</el-button>\r\n        </template>\r\n      </el-input>\r\n    </div>\r\n  </div>\r\n</template>\r\n<script>\r\nimport { seend_message_fun } from \"@/socke/index.js\";\r\nexport default {\r\n  name: 'Chat_Room_infomation_view',\r\n  data() {\r\n    return {\r\n      message: \"\",\r\n    }\r\n  },\r\n  computed: {\r\n    userStatus() {\r\n      if (!this.$store.state.currentChat) return { type: 'info', text: '未知' };\r\n      const isOnline = this.$store.state.Online_Numbers.includes(this.$store.state.currentChat);\r\n      return {\r\n        type: isOnline ? 'success' : 'info',\r\n        text: isOnline ? '在线' : '离线'\r\n      };\r\n    },\r\n  },\r\n  methods: {\r\n    sendMessage() {\r\n      seend_message_fun(this.message, this.$store.state.currentChat)\r\n      this.message = \"\";\r\n    },\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.chat-bgcolor {\r\n  height: 67vh;\r\n  background-color: #ffffff;\r\n  overflow-y: auto;\r\n  margin-top: 3vh;\r\n  border-radius: 10px;\r\n  padding: 15px;\r\n  box-sizing: border-box;\r\n}\r\n\r\n.message-item {\r\n  margin-bottom: 15px;\r\n\r\n}\r\n\r\n.message-content {\r\n  padding: 10px 15px;\r\n  border-radius: 8px;\r\n  background-color: #f0f8ff;\r\n  max-width: 25vw;\r\n  word-break: break-all\r\n}\r\n.avatars{\r\n  padding: 10px 15px;\r\n  border-radius: 8px;\r\n  background-color: #f0f8ff;\r\n  max-width: 25vw;\r\n  word-break: break-all\r\n}\r\n.current-user .message-content {\r\n  background-color: #e1f3ff;\r\n  margin-left: auto;\r\n}\r\n\r\n.message-sender {\r\n  font-weight: bold;\r\n  font-size: 12px;\r\n  color: #666;\r\n}\r\n\r\n.message-text {\r\n  margin: 5px 0;\r\n  font-family: '宋体';\r\n  font-size: 1vw;\r\n}\r\n\r\n.message-time {\r\n  font-size: 10px;\r\n  color: #999;\r\n  text-align: right;\r\n}\r\n\r\n/* 保持原有样式不变 */\r\n.el-input {\r\n  height: 6vh;\r\n  background: #f0f8ff;\r\n}\r\n\r\n.chat-room-container {\r\n  display: flex;\r\n  background-color: #f5f7fa;\r\n}\r\n\r\n.sidebar {\r\n  /* width: 300px; */\r\n  border-right: 1px solid #e2e5ec;\r\n  background: #f0f8ff;\r\n}\r\n\r\n.main-content {\r\n  flex: 1;\r\n  display: flex;\r\n  flex-direction: column;\r\n  margin-top: 2vh;\r\n}\r\n\r\n.chat-header {\r\n  padding: 15px 0;\r\n  background: #fff;\r\n  position: sticky;\r\n  top: 0;\r\n  z-index: 1;\r\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);\r\n  border-radius: 10px;\r\n}\r\n\r\n.message-input {\r\n  /* width: 60vw; */\r\n  margin-top: 3vh;\r\n}\r\n</style>\r\n"],"mappings":"AAoCA,SAASA,iBAAgB,QAAS,kBAAkB;AACpD,eAAe;EACbC,IAAI,EAAE,2BAA2B;EACjCC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,OAAO,EAAE;IACX;EACF,CAAC;EACDC,QAAQ,EAAE;IACRC,UAAUA,CAAA,EAAG;MACX,IAAI,CAAC,IAAI,CAACC,MAAM,CAACC,KAAK,CAACC,WAAW,EAAE,OAAO;QAAEC,IAAI,EAAE,MAAM;QAAEC,IAAI,EAAE;MAAK,CAAC;MACvE,MAAMC,QAAO,GAAI,IAAI,CAACL,MAAM,CAACC,KAAK,CAACK,cAAc,CAACC,QAAQ,CAAC,IAAI,CAACP,MAAM,CAACC,KAAK,CAACC,WAAW,CAAC;MACzF,OAAO;QACLC,IAAI,EAAEE,QAAO,GAAI,SAAQ,GAAI,MAAM;QACnCD,IAAI,EAAEC,QAAO,GAAI,IAAG,GAAI;MAC1B,CAAC;IACH;EACF,CAAC;EACDG,OAAO,EAAE;IACPC,WAAWA,CAAA,EAAG;MACZf,iBAAiB,CAAC,IAAI,CAACG,OAAO,EAAE,IAAI,CAACG,MAAM,CAACC,KAAK,CAACC,WAAW;MAC7D,IAAI,CAACL,OAAM,GAAI,EAAE;IACnB;EACF;AACF"},"metadata":{},"sourceType":"module","externalDependencies":[]}