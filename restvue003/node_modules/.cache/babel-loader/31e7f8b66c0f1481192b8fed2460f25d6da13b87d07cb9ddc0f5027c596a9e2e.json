{"ast":null,"code":"import \"core-js/modules/web.url-search-params.delete.js\";\nimport \"core-js/modules/web.url-search-params.has.js\";\nimport \"core-js/modules/web.url-search-params.size.js\";\nimport axios from 'axios';\nexport default {\n  name: \"downloadFlie\",\n  props: [\"down\"],\n  data() {\n    return {\n      url: \"\"\n    };\n  },\n  methods: {\n    downloadFlie(s) {\n      let url = this.$store.state.api + \"/download?downloadPathName=\" + this.$store.state.DirPath + \"/\" + s + \"&downloadName=\" + s;\n      // window.location.href = url;  \n      axios({\n        url: url,\n        method: \"get\",\n        responseType: \"blob\"\n      }).then(response => {\n        const blob = new Blob([response.data]);\n        // 创建下载链接\n        const downloadUrl = window.URL.createObjectURL(blob);\n        const link = document.createElement('a');\n        link.href = downloadUrl;\n        // 从响应头获取文件名，如果不可用则使用prop传入的文件名\n        const contentDisposition = response.headers['content-disposition'];\n        let downloadFilename = down;\n        if (contentDisposition) {\n          const filenameMatch = contentDisposition.match(/filename=\"?(.+)\"?/);\n          if (filenameMatch && filenameMatch[1]) {\n            downloadFilename = filenameMatch[1];\n          }\n        }\n        link.setAttribute('download', downloadFilename);\n        document.body.appendChild(link);\n\n        // 触发下载\n        link.click();\n\n        // 清理\n        link.remove();\n        window.URL.revokeObjectURL(downloadUrl);\n\n        // 可以在这里添加成功回调或通知用户\n        this.$message.success('文件下载成功');\n      }).catch(err => {\n        console.log(err);\n      });\n    }\n  }\n};","map":{"version":3,"names":["axios","name","props","data","url","methods","downloadFlie","s","$store","state","api","DirPath","method","responseType","then","response","blob","Blob","downloadUrl","window","URL","createObjectURL","link","document","createElement","href","contentDisposition","headers","downloadFil