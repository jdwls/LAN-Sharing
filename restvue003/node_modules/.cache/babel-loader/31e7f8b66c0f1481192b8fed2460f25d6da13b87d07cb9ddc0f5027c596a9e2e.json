);\r\n\r\n          // 可以在这里添加成功回调或通知用户\r\n          this.$message.success('文件下载成功');\r\n        })\r\n        .catch((err) => {\r\n          console.log(err);\r\n\r\n        })\r\n    },\r\n  },\r\n};\r\n</script>\r\n"],"mappings":";;;AAMA,OAAOA,KAAI,MAAO,OAAO;AAEzB,eAAe;EACbC,IAAI,EAAE,cAAc;EACpBC,KAAK,EAAE,CAAC,MAAM,CAAC;EACfC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,GAAG,EAAE;IACP,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACPC,YAAYA,CAACC,CAAC,EAAE;MACd,IAAIH,GAAE,GACJ,IAAI,CAACI,MAAM,CAACC,KAAK,CAACC,GAAE,GACpB,6BAA4B,GAC5B,IAAI,CAACF,MAAM,CAACC,KAAK,CAACE,OAAM,GACxB,GAAE,GACFJ,CAAA,GACA,gBAAe,GACfA,CAAC;MACH;MACAP,KAAK,CAAC;QACJI,GAAG,EAAEA,GAAG;QACRQ,MAAM,EAAE,KAAK;QACbC,YAAY,EAAE;MAChB,CAAC,EACEC,IAAI,CAAEC,QAAQ,IAAK;QAClB,MAAMC,IAAG,GAAI,IAAIC,IAAI,CAAC,CAACF,QAAQ,CAACZ,IAAI,CAAC,CAAC;QACtC;QACA,MAAMe,WAAU,GAAIC,MAAM,CAACC,GAAG,CAACC,eAAe,CAACL,IAAI,CAAC;QACpD,MAAMM,IAAG,GAAIC,QAAQ,CAACC,aAAa,CAAC,GAAG,CAAC;QACxCF,IAAI,CAACG,IAAG,GAAIP,WAAW;QACvB;QACA,MAAMQ,kBAAiB,GAAIX,QAAQ,CAACY,OAAO,CAAC,qBAAqB,CAAC;QAClE,IAAIC,gBAAe,GAAIC,IAAI;QAE3B,IAAIH,kBAAkB,EAAE;UACtB,MAAMI,aAAY,GAAIJ,kBAAkB,CAACK,KAAK,CAAC,mBAAmB,CAAC;UACnE,IAAID,aAAY,IAAKA,aAAa,CAAC,CAAC,CAAC,EAAE;YACrCF,gBAAe,GAAIE,aAAa,CAAC,CAAC,CAAC;UACrC;QACF;QAEAR,IAAI,CAACU,YAAY,CAAC,UAAU,EAAEJ,gBAAgB,CAAC;QAC/CL,QAAQ,CAACU,IAAI,CAACC,WAAW,CAACZ,IAAI,CAAC;;QAE/B;QACAA,IAAI,CAACa,KAAK,CAAC,CAAC;;QAEZ;QACAb,IAAI,CAACc,MAAM,CAAC,CAAC;QACbjB,MAAM,CAACC,GAAG,CAACiB,eAAe,CAACnB,WAAW,CAAC;;QAEvC;QACA,IAAI,CAACoB,QAAQ,CAACC,OAAO,CAAC,QAAQ,CAAC;MACjC,CAAC,EACAC,KAAK,CAAEC,GAAG,IAAK;QACdC,OAAO,CAACC,GAAG,CAACF,GAAG,CAAC;MAElB,CAAC;IACL;EACF;AACF,CAAC"},"metadata":{},"sourceType":"module","externalDependencies":[]}