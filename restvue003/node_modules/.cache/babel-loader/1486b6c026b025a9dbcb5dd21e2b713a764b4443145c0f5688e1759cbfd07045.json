{"ast":null,"code":"import { seend_message_fun } from \"@/socke/index.js\";\nexport default {\n  name: 'Chat_Room_infomation_view',\n  data() {\n    return {\n      message: \"\"\n    };\n  },\n  computed: {\n    userStatus() {\n      if (!this.$store.state.currentChat) return {\n        type: 'info',\n        text: '未知'\n      };\n      const isOnline = this.$store.state.Online_Numbers.includes(this.$store.state.currentChat);\n      return {\n        type: isOnline ? 'success' : 'info',\n        text: isOnline ? '在线' : '离线'\n      };\n    }\n  },\n  methods: {\n    sendMessage() {\n      seend_message_fun(this.message, this.$store.state.currentChat);\n      this.message = \"\";\n    }\n  }\n};","map":{"version":3,"names":["seend_message_fun","name","data","message","computed","userStatus","$store","state","currentChat","type","text","isOnline","Online_Numbers","includes","methods","sendMessage"],"sources":["C:\\Users\\administered\\Desktop\\code\\restvue003\\src\\components\\ChatRoom\\Chat_Room_infomation\\Chat_Room_infomation_view.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <div class=\"chat-header card\">\r\n      <el-row align=\"middle\" gutter=\"1.046vw\">\r\n        <el-col :span=\"3\">\r\n          <el-avatar size=\"3.138vw\" src=\"https://cube.elemecdn.com/0/88/03b0d39583f48206768a7534e55bcpng.png\" />\r\n        </el-col>\r\n        <el-col :span=\"21\">\r\n          <h2 class=\"header-title\">与 {{ $store.state.currentChat }} 的对话</h2>\r\n          <p class=\"status-text\">\r\n            <el-tag size=\"small\" :type=\"userStatus.type\">{{ userStatus.text }}</el-tag>\r\n          </p>\r\n        </el-col>\r\n      </el-row>\r\n      <el-divider class=\"header-divider\" />\r\n    </div>\r\n    <div class=\"chat-bgcolor\">\r\n      <div v-for=\"msg in $store.state.messages_lists\" :key=\"msg.id\" class=\"message-item\"\r\n        :class=\"{ 'current-user': msg.current_usrs, 'other-user': !msg.current_usrs }\">\r\n        <div class=\"message-content\">\r\n          <div class=\"message-avatar\"><el-avatar src=\"https://cube.elemecdn.com/0/88/03b0d39583f48206768a7534e55bcpng.png\" /></div>\r\n          <div class=\"message-bubble\">\r\n            <div class=\"message-text\">{{ msg.message }}</div>\r\n            <div class=\"message-time\">{{ new Date(msg.Time * 1000).toLocaleTimeString() }}</div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n    <div class=\"message-input\">\r\n      <el-input placeholder=\"输入消息...\" v-model=\"message\"  @keyup.enter=\"sendMessage\" \r\n      type=\"textarea\"\r\n      :autosize=\"{ minRows: 4, maxRows: 4 }\"\r\n      resize=\"none\"\r\n      class=\"el-input_s\"\r\n      >\r\n      </el-input>\r\n       <el-button  @click=\"sendMessage\">发送</el-button>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { seend_message_fun } from \"@/socke/index.js\";\r\nexport default {\r\n  name: 'Chat_Room_infomation_view',\r\n  data() {\r\n    return {\r\n      message: \"\",\r\n    }\r\n  },\r\n  computed: {\r\n    userStatus() {\r\n      if (!this.$store.state.currentChat) return { type: 'info', text: '未知' };\r\n      const isOnline = this.$store.state.Online_Numbers.includes(this.$store.state.currentChat);\r\n      return {\r\n        type: isOnline ? 'success' : 'info',\r\n        text: isOnline ? '在线' : '离线'\r\n      };\r\n    },\r\n  },\r\n  methods: {\r\n    sendMessage() {\r\n      seend_message_fun(this.message, this.$store.state.currentChat)\r\n      this.message = \"\";\r\n    },\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.chat-bgcolor {\r\n  height: 60vh;\r\n  background-color: #f5f7fa;\r\n  overflow-y: auto;\r\n  margin-top: 3vh;\r\n  border-radius: 1.046vw;\r\n  padding: 1.569vw;\r\n  box-sizing: border-box;\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.message-item {\r\n  margin-bottom: 1.569vw;\r\n  display: flex;\r\n}\r\n\r\n/* 当前用户消息样式 (右侧) */\r\n.message-item.current-user {\r\n  justify-content: flex-end;\r\n}\r\n\r\n.current-user .message-content {\r\n  flex-direction: row-reverse;\r\n}\r\n\r\n.current-user .message-bubble {\r\n  background-color: #409EFF;\r\n  color: white;\r\n  border-radius: 1.883vw 1.883vw 0 1.883vw;\r\n  margin-right: 1.046vw;\r\n}\r\n\r\n.current-user .message-time {\r\n  color: rgba(255, 255, 255, 0.7);\r\n}\r\n\r\n/* 其他用户消息样式 (左侧) */\r\n.message-item.other-user {\r\n  justify-content: flex-start;\r\n}\r\n\r\n.other-user .message-content {\r\n  flex-direction: row;\r\n}\r\n\r\n.other-user .message-bubble {\r\n  background-color: #ffffff;\r\n  color: #303133;\r\n  border-radius: 1.883vw 1.883vw 1.883vw 0;\r\n  margin-left: 1.046vw;\r\n  box-shadow: 0 0.1046vw 0.3138vw rgba(0, 0, 0, 0.1);\r\n}\r\n\r\n.other-user .message-time {\r\n  color: #909399;\r\n}\r\n\r\n.message-content {\r\n  display: flex;\r\n  max-width: 30vw;\r\n}\r\n\r\n.message-avatar {\r\n  display: flex;\r\n  align-items: flex-end;\r\n}\r\n\r\n.message-bubble {\r\n  padding: 1.256vw 1.675vw;\r\n  position: relative;\r\n  word-break: break-word;\r\n}\r\n\r\n.message-text {\r\n  margin: 0;\r\n  font-size: 1.466vw;\r\n  line-height: 1.5;\r\n}\r\n\r\n.message-time {\r\n  font-size: 1.151vw;\r\n  margin-top: 0.419vw;\r\n  text-align: right;\r\n}\r\n\r\n/* 输入框样式 */\r\n.el-input {\r\n  height: 6vh;\r\n  background: #ffffff;\r\n  border-radius: 2.093vw;\r\n  box-shadow: 0 0.209vw 1.046vw rgba(0, 0, 0, 0.08);\r\n}\r\n\r\n.chat-header {\r\n  padding: 1.569vw 0;\r\n  background: #fff;\r\n  position: sticky;\r\n  top: 0;\r\n  z-index: 1;\r\n  box-shadow: 0 0.209vw 0.837vw rgba(0, 0, 0, 0.05);\r\n  border-radius: 1.046vw;\r\n}\r\n\r\n.message-input {\r\n  display: flex;\r\n  margin-top: 3vh;\r\n  padding: 0 1.569vw;\r\n  width: 67vw;\r\n  margin-top: auto;\r\n}\r\n\r\n.header-title {\r\n  margin: 0 0 0.523vw 0;\r\n  font-weight: 600;\r\n  color: #303133;\r\n  font-size: 1.675vw;\r\n}\r\n\r\n.status-text {\r\n  margin: 0;\r\n  font-size: 1.466vw;\r\n  color: #909399;\r\n}\r\n\r\n.header-divider {\r\n  margin: 1.569vw 0;\r\n}\r\n\r\n.el-textarea__inner {\r\n  resize: none;\r\n  align-items: flex-end;\r\n}\r\n</style>"],"mappings":"AA0CA,SAASA,iBAAgB,QAAS,kBAAkB;AACpD,eAAe;EACbC,IAAI,EAAE,2BAA2B;EACjCC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,OAAO,EAAE;IACX;EACF,CAAC;EACDC,QAAQ,EAAE;IACRC,UAAUA,CAAA,EAAG;MACX,IAAI,CAAC,IAAI,CAACC,MAAM,CAACC,KAAK,CAACC,WAAW,EAAE,OAAO;QAAEC,IAAI,EAAE,MAAM;QAAEC,IAAI,EAAE;MAAK,CAAC;MACvE,MAAMC,QAAO,GAAI,IAAI,CAACL,MAAM,CAACC,KAAK,CAACK,cAAc,CAACC,QAAQ,CAAC,IAAI,CAACP,MAAM,CAACC,KAAK,CAACC,WAAW,CAAC;MACzF,OAAO;QACLC,IAAI,EAAEE,QAAO,GAAI,SAAQ,GAAI,MAAM;QACnCD,IAAI,EAAEC,QAAO,GAAI,IAAG,GAAI;MAC1B,CAAC;IACH;EACF,CAAC;EACDG,OAAO,EAAE;IACPC,WAAWA,CAAA,EAAG;MACZf,iBAAiB,CAAC,IAAI,CAACG,OAAO,EAAE,IAAI,CAACG,MAAM,CAACC,KAAK,CAACC,WAAW;MAC7D,IAAI,CAACL,OAAM,GAAI,EAAE;IACnB;EACF;AACF"},"metadata":{},"sourceType":"module","externalDependencies":[]}