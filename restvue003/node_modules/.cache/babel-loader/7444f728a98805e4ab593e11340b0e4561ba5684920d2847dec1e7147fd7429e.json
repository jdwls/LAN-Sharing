{"ast":null,"code":"import UrseLIst from \"@/components/ChatRoom/UrseLIst/UrseLIst.vue\";\nimport Chat_Room_infomation_view from \"@/components/ChatRoom/Chat_Room_infomation/Chat_Room_infomation_view.vue\";\nimport { disconnectSocket, connectSocket } from '@/socke/index.js';\nexport default {\n  name: \"ChatRoomIndex\",\n  components: {\n    UrseLIst,\n    Chat_Room_infomation_view\n  },\n  data() {\n    return {\n      cu: '' // 当前选中的用户\n    };\n  },\n  methods: {\n    startChat(user) {\n      this.cu = user; // 设置当前聊天用户\n    }\n  },\n  mounted() {\n    this.$store.dispatch(\"Tokers\");\n    connectSocket();\n  },\n  beforeUnmount() {\n    if (this.socket) {\n      disconnectSocket();\n    }\n  }\n};","map":{"version":3,"names":["UrseLIst","Chat_Room_infomation_view","disconnectSocket","connectSocket","name","components","data","cu","methods","startChat","user","mounted","$store","dispatch","beforeUnmount","socket"],"sources":["C:\\Users\\administered\\Desktop\\code\\restvue003\\src\\components\\ChatRoom\\ChatRoomIndex.vue"],"sourcesContent":["<template>\r\n  <div class=\"chat-room-container\">\r\n    <div class=\"sidebar\">\r\n      <UrseLIst @user-selected=\"startChat\" />\r\n    </div>\r\n    <div class=\"main-content\">\r\n      <!-- 使用 props 传递数据而不是事件监听 -->\r\n      <Chat_Room_infomation_view :current-chat=\"cu\" />\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport UrseLIst from \"@/components/ChatRoom/UrseLIst/UrseLIst.vue\";\r\nimport Chat_Room_infomation_view from \"@/components/ChatRoom/Chat_Room_infomation/Chat_Room_infomation_view.vue\"\r\nimport {disconnectSocket,connectSocket} from '@/socke/index.js'\r\nexport default {\r\n  name: \"ChatRoomIndex\",\r\n  components: {\r\n    UrseLIst,\r\n    Chat_Room_infomation_view\r\n  },\r\n  data() {\r\n    return {\r\n      cu: '' // 当前选中的用户\r\n    }\r\n  },\r\n  methods: {\r\n    startChat(user) {\r\n      this.cu = user; // 设置当前聊天用户\r\n    },\r\n  },\r\n  mounted() {\r\n    this.$store.dispatch(\"Tokers\");\r\n    connectSocket();\r\n  },\r\n   beforeUnmount() {\r\n    if (this.socket) {\r\n       disconnectSocket()\r\n    }\r\n   \r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n/* 保持原有样式不变 */\r\n.el-input {\r\n  height: 6vh;\r\n  background: #f0f8ff;\r\n}\r\n\r\n.chat-room-container {\r\n  display: flex;\r\n  background-color: #f5f7fa;\r\n}\r\n\r\n.sidebar {\r\n  width: 300px;\r\n  border-right: 1px solid #e2e5ec;\r\n  background: #f0f8ff;\r\n}\r\n\r\n.main-content {\r\n  flex: 1;\r\n  display: flex;\r\n  flex-direction: column;\r\n  margin-top: 2vh;\r\n}\r\n\r\n.chat-header {\r\n  padding: 15px 0;\r\n  background: #fff;\r\n  position: sticky;\r\n  top: 0;\r\n  z-index: 1;\r\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);\r\n  border-radius: 10px;\r\n}\r\n\r\n.message-input {\r\n  width: 70vw;\r\n  margin-top: 3vh;\r\n}\r\n\r\n.chat-bgcolor {\r\n  width: 70vw;\r\n  height: 67vh;\r\n  background-color: #ffffff;\r\n  overflow-y: hidden;\r\n  margin-top: 3vh;\r\n  border-radius: 10px;\r\n}\r\n</style>"],"mappings":"AAaA,OAAOA,QAAO,MAAO,6CAA6C;AAClE,OAAOC,yBAAwB,MAAO,0EAAyE;AAC/G,SAAQC,gBAAgB,EAACC,aAAa,QAAO,kBAAiB;AAC9D,eAAe;EACbC,IAAI,EAAE,eAAe;EACrBC,UAAU,EAAE;IACVL,QAAQ;IACRC;EACF,CAAC;EACDK,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,EAAE,EAAE,EAAC,CAAE;IACT;EACF,CAAC;EACDC,OAAO,EAAE;IACPC,SAASA,CAACC,IAAI,EAAE;MACd,IAAI,CAACH,EAAC,GAAIG,IAAI,EAAE;IAClB;EACF,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,MAAM,CAACC,QAAQ,CAAC,QAAQ,CAAC;IAC9BV,aAAa,CAAC,CAAC;EACjB,CAAC;EACAW,aAAaA,CAAA,EAAG;IACf,IAAI,IAAI,CAACC,MAAM,EAAE;MACdb,gBAAgB,CAAC;IACpB;EAEF;AACF,CAAC"},"metadata":{},"sourceType":"module","externalDependencies":[]}