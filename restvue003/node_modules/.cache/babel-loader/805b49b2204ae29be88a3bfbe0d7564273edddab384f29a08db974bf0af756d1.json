{"ast":null,"code":"export default {\n  name: \"progressEl\",\n  data() {\n    return {\n      size: \"\"\n    };\n  },\n  computed: {\n    UpdataTotal() {\n      if (this.$store.state.upadaFileNumberSum != this.$store.state.files.length) {\n        return \"当前文件上传总数为：\" + this.$store.state.upadaFileNumberSum + \"个文件,已经上传\" + this.$store.state.files.length + \"个文件\";\n      } else {\n        this.$store.dispatch(\"DirsFileList\");\n        return \"已经完成上传所有文件\";\n      }\n    }\n  },\n  methods: {\n    SuLvZhuangHuang(i) {\n      if (i < 1024) {\n        return i.toFixed(2) + \" B/s\";\n      } else if (i < 1024 * 1024) {\n        return (i / 1024).toFixed(2) + \" KB/s\";\n      } else if (i < 1024 * 1024 * 1024) {\n        return (i / (1024 * 1024)).toFixed(2) + \" MB/s\";\n      } else {\n        return (i / (1024 * 1024 * 1024)).toFixed(2) + \" GB/s\";\n      }\n    },\n    FileSize(i) {\n      if (i < 1024) {\n        return i.toFixed(2) + \" B\";\n      } else if (i < 1024 * 1024) {\n        return (i / 1024).toFixed(2) + \" KB\";\n      } else if (i < 1024 * 1024 * 1024) {\n        return (i / (1024 * 1024)).toFixed(2) + \" MB\";\n      } else {\n        return (i / (1024 * 1024 * 1024)).toFixed(2) + \" GB\";\n      }\n    }\n  }\n};","map":{"version":3,"names":["name","data","size","computed","UpdataTotal","$store","state","upadaFileNumberSum","files","length","dispatch","methods","SuLvZhuangHuang","i","toFixed","FileSize"],"sources":["F:\\Windows\\Desktop\\code\\restvue003\\src\\components\\progressEl.vue"],"sourcesContent":["<template>\n  <el-table\n    :data=\"$store.state.files\"\n    style=\"width: auto\"\n    border\n    max-height=\"75vh\"\n  >\n    <el-table-column :label=\"UpdataTotal()\">\n      <el-table-column prop=\"data\" label=\"文件名\" width=\"360vw\" align=\"center\">\n        <template #default=\"scope\">\n          <span>{{ scope.row.name }}</span>\n        </template>\n      </el-table-column>\n      <el-table-column\n        prop=\"data\"\n        label=\"文件大小\"\n        width=\"240vw\"\n        align=\"center\"\n      >\n        <template #default=\"scope\">\n          <span>{{ FileSize(scope.row.size) }}</span>\n        </template>\n      </el-table-column>\n      <el-table-column\n        prop=\"data\"\n        label=\"上传速度\"\n        width=\"240vw\"\n        align=\"center\"\n      >\n        <template #default=\"scope\">\n          <span>速度:{{ SuLvZhuangHuang(scope.row.speed) }}</span>\n        </template>\n      </el-table-column>\n      <el-table-column prop=\"data\" label=\"进度条\" width=\"200vw\" align=\"center\">\n        <template #default=\"scope\">\n          <el-progress\n            :percentage=\"Number(scope.row.progress)\"\n            :text-inside=\"true\"\n            :stroke-width=\"18\"\n          ></el-progress>\n        </template>\n      </el-table-column>\n    </el-table-column>\n  </el-table>\n  <!-- </div> -->\n</template>\n\n<script>\nexport default {\n  name: \"progressEl\",\n  data() {\n    return {\n      size: \"\",\n    };\n  },\n  computed: {\n    UpdataTotal() {\n      if (\n        this.$store.state.upadaFileNumberSum != this.$store.state.files.length\n      ) {\n        return (\n          \"当前文件上传总数为：\" +\n          this.$store.state.upadaFileNumberSum +\n          \"个文件,已经上传\" +\n          this.$store.state.files.length +\n          \"个文件\"\n        );\n      } else {\n        this.$store.dispatch(\"DirsFileList\");\n        return \"已经完成上传所有文件\";\n      }\n    },\n  },\n  methods: {\n    SuLvZhuangHuang(i) {\n      if (i < 1024) {\n        return i.toFixed(2) + \" B/s\";\n      } else if (i < 1024 * 1024) {\n        return (i / 1024).toFixed(2) + \" KB/s\";\n      } else if (i < 1024 * 1024 * 1024) {\n        return (i / (1024 * 1024)).toFixed(2) + \" MB/s\";\n      } else {\n        return (i / (1024 * 1024 * 1024)).toFixed(2) + \" GB/s\";\n      }\n    },\n\n    FileSize(i) {\n      if (i < 1024) {\n        return i.toFixed(2) + \" B\";\n      } else if (i < 1024 * 1024) {\n        return (i / 1024).toFixed(2) + \" KB\";\n      } else if (i < 1024 * 1024 * 1024) {\n        return (i / (1024 * 1024)).toFixed(2) + \" MB\";\n      } else {\n        return (i / (1024 * 1024 * 1024)).toFixed(2) + \" GB\";\n      }\n    },\n  },\n};\n</script>\n"],"mappings":"AAgDA,eAAe;EACbA,IAAI,EAAE,YAAY;EAClBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,IAAI,EAAE;IACR,CAAC;EACH,CAAC;EACDC,QAAQ,EAAE;IACRC,WAAWA,CAAA,EAAG;MACZ,IACE,IAAI,CAACC,MAAM,CAACC,KAAK,CAACC,kBAAiB,IAAK,IAAI,CAACF,MAAM,CAACC,KAAK,CAACE,KAAK,CAACC,MAAK,EACrE;QACA,OACE,YAAW,GACX,IAAI,CAACJ,MAAM,CAACC,KAAK,CAACC,kBAAiB,GACnC,UAAS,GACT,IAAI,CAACF,MAAM,CAACC,KAAK,CAACE,KAAK,CAACC,MAAK,GAC7B,KAAI;MAER,OAAO;QACL,IAAI,CAACJ,MAAM,CAACK,QAAQ,CAAC,cAAc,CAAC;QACpC,OAAO,YAAY;MACrB;IACF;EACF,CAAC;EACDC,OAAO,EAAE;IACPC,eAAeA,CAACC,CAAC,EAAE;MACjB,IAAIA,CAAA,GAAI,IAAI,EAAE;QACZ,OAAOA,CAAC,CAACC,OAAO,CAAC,CAAC,IAAI,MAAM;MAC9B,OAAO,IAAID,CAAA,GAAI,IAAG,GAAI,IAAI,EAAE;QAC1B,OAAO,CAACA,CAAA,GAAI,IAAI,EAAEC,OAAO,CAAC,CAAC,IAAI,OAAO;MACxC,OAAO,IAAID,CAAA,GAAI,IAAG,GAAI,IAAG,GAAI,IAAI,EAAE;QACjC,OAAO,CAACA,CAAA,IAAK,IAAG,GAAI,IAAI,CAAC,EAAEC,OAAO,CAAC,CAAC,IAAI,OAAO;MACjD,OAAO;QACL,OAAO,CAACD,CAAA,IAAK,IAAG,GAAI,IAAG,GAAI,IAAI,CAAC,EAAEC,OAAO,CAAC,CAAC,IAAI,OAAO;MACxD;IACF,CAAC;IAEDC,QAAQA,CAACF,CAAC,EAAE;MACV,IAAIA,CAAA,GAAI,IAAI,EAAE;QACZ,OAAOA,CAAC,CAACC,OAAO,CAAC,CAAC,IAAI,IAAI;MAC5B,OAAO,IAAID,CAAA,GAAI,IAAG,GAAI,IAAI,EAAE;QAC1B,OAAO,CAACA,CAAA,GAAI,IAAI,EAAEC,OAAO,CAAC,CAAC,IAAI,KAAK;MACtC,OAAO,IAAID,CAAA,GAAI,IAAG,GAAI,IAAG,GAAI,IAAI,EAAE;QACjC,OAAO,CAACA,CAAA,IAAK,IAAG,GAAI,IAAI,CAAC,EAAEC,OAAO,CAAC,CAAC,IAAI,KAAK;MAC/C,OAAO;QACL,OAAO,CAACD,CAAA,IAAK,IAAG,GAAI,IAAG,GAAI,IAAI,CAAC,EAAEC,OAAO,CAAC,CAAC,IAAI,KAAK;MACtD;IACF;EACF;AACF,CAAC"},"metadata":{},"sourceType":"module","externalDependencies":[]}