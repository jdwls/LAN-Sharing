{"ast":null,"code":"import { seend_message_fun } from \"@/socke/index.js\";\nimport { nextTick } from \"vue\";\nexport default {\n  name: 'Chat_Room_infomation_view',\n  data() {\n    return {\n      message: \"\",\n      autoScroll: true // 控制是否自动滚动\n    };\n  },\n  computed: {\n    userStatus() {\n      if (!this.$store.state.currentChat) return {\n        type: 'info',\n        text: '未知'\n      };\n      const isOnline = this.$store.state.Online_Numbers.includes(this.$store.state.currentChat);\n      return {\n        type: isOnline ? 'success' : 'info',\n        text: isOnline ? '在线' : '离线'\n      };\n    }\n  },\n  methods: {\n    sendMessage() {\n      if (!this.message.trim()) return;\n      seend_message_fun(this.message, this.$store.state.currentChat);\n      this.message = \"\";\n      this.scrollToBottom();\n    },\n    // 滚动到底部\n    scrollToBottom() {\n      if (!this.autoScroll) return;\n      nextTick(() => {\n        const scrollbar = this.$refs.scrollbarRef;\n        if (scrollbar) {\n          scrollbar.setScrollTop(scrollbar.wrap$.scrollHeight);\n        }\n      });\n    },\n    // 处理滚动事件\n    handleScroll({\n      scrollTop,\n      wrap$\n    }) {\n      // 当用户滚动到接近底部时，重新启用自动滚动\n      const threshold = 100; // 距离底部的阈值\n      this.autoScroll = scrollTop + wrap$.clientHeight >= wrap$.scrollHeight - threshold;\n    }\n  },\n  watch: {\n    // 监听消息列表变化\n    '$store.state.messages_lists': {\n      handler() {\n        this.scrollToBottom();\n      },\n      deep: true\n    }\n  },\n  mounted() {\n    this.scrollToBottom();\n  }\n};","map":{"version":3,"names":["seend_message_fun","nextTick","name","data","message","autoScroll","computed","userStatus","$store","state","currentChat","type","text","isOnline","Online_Numbers","includes","methods","sendMessage","trim","scrollToBottom","scrollbar","$refs","scrollbarRef","setScrollTop","wrap$","scrollHeight","handleScroll","scrollTop","threshold","clientHeight","watch","handler","deep","mounted"],"sources":["C:\\Users\\administered\\Desktop\\code\\restvue003\\src\\components\\ChatRoom\\Chat_Room_infomation\\Chat_Room_infomation_view.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <div class=\"chat-header card\">\r\n      <el-row align=\"middle\" :gutter=\"20\">\r\n        <el-col :span=\"2\" style=\"padding-left: 1.5vw;\">\r\n          <el-avatar :size=\"60\" src=\"https://cube.elemecdn.com/0/88/03b0d39583f48206768a7534e55bcpng.png\" />\r\n        </el-col>\r\n        <el-col :span=\"21\">\r\n          <h2 style=\"margin:0 0 0.2604vw 0;font-weight:600;color:#303133\">与 {{ $store.state.currentChat }} 的对话</h2>\r\n          <p style=\"margin:0;font-size:0.7292vw;color:#909399\">\r\n            <el-tag size=\"small\" :type=\"userStatus.type\">{{ userStatus.text }}</el-tag>\r\n          </p>\r\n        </el-col>\r\n      </el-row>\r\n      <el-divider style=\"margin:0.4vw 0\" />\r\n    </div>\r\n    <div class=\"chat-bgcolor\">\r\n      <el-scrollbar ref=\"scrollbarRef\" always @scroll=\"handleScroll\">\r\n        <div v-for=\"msg in $store.state.messages_lists\" :key=\"msg.id\" class=\"message-item\"\r\n          :class=\"{ 'current-user': msg.current_usrs, 'other-user': !msg.current_usrs }\">\r\n          <div class=\"message-content\">\r\n            <div class=\"message-avatar\"><el-avatar\r\n                src=\"https://cube.elemecdn.com/0/88/03b0d39583f48206768a7534e55bcpng.png\" /></div>\r\n            <div class=\"message-bubble\">\r\n              <div class=\"message-text\">{{ msg.message }}</div>\r\n              <div class=\"message-time\">{{ new Date(msg.Time * 1000).toLocaleTimeString() }}</div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </el-scrollbar>\r\n    </div>\r\n    <div class=\"message-input\">\r\n      <div class=\"ms-in\">\r\n        <el-input placeholder=\"输入消息...\" v-model=\"message\" type=\"textarea\" :autosize=\"{ minRows: 2, maxRows: 2 }\"\r\n          resize=\"none\" class=\"el-input_s\" @keyup.enter=\"sendMessage\">\r\n        </el-input>\r\n      </div>\r\n\r\n      <div class=\"send_Message_css\">\r\n        <el-button @click=\"sendMessage\" type=\"primary\" size=\"large\">发送</el-button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { seend_message_fun } from \"@/socke/index.js\";\r\nimport { nextTick } from \"vue\";\r\nexport default {\r\n  name: 'Chat_Room_infomation_view',\r\n  data() {\r\n    return {\r\n      message: \"\",\r\n      autoScroll: true, // 控制是否自动滚动\r\n    }\r\n  },\r\n  computed: {\r\n    userStatus() {\r\n      if (!this.$store.state.currentChat) return { type: 'info', text: '未知' };\r\n      const isOnline = this.$store.state.Online_Numbers.includes(this.$store.state.currentChat);\r\n      return {\r\n        type: isOnline ? 'success' : 'info',\r\n        text: isOnline ? '在线' : '离线'\r\n      };\r\n    },\r\n  },\r\n  methods: {\r\n    sendMessage() {\r\n      if (!this.message.trim()) return;\r\n      \r\n      seend_message_fun(this.message, this.$store.state.currentChat)\r\n      this.message = \"\";\r\n      this.scrollToBottom();\r\n    },\r\n    \r\n    // 滚动到底部\r\n    scrollToBottom() {\r\n      if (!this.autoScroll) return;\r\n      \r\n      nextTick(() => {\r\n        const scrollbar = this.$refs.scrollbarRef;\r\n        if (scrollbar) {\r\n          scrollbar.setScrollTop(scrollbar.wrap$.scrollHeight);\r\n        }\r\n      });\r\n    },\r\n    \r\n    // 处理滚动事件\r\n    handleScroll({ scrollTop, wrap$ }) {\r\n      // 当用户滚动到接近底部时，重新启用自动滚动\r\n      const threshold = 100; // 距离底部的阈值\r\n      this.autoScroll = scrollTop + wrap$.clientHeight >= wrap$.scrollHeight - threshold;\r\n    },\r\n  },\r\n  watch: {\r\n    // 监听消息列表变化\r\n    '$store.state.messages_lists': {\r\n      handler() {\r\n        this.scrollToBottom();\r\n      },\r\n      deep: true\r\n    }\r\n  },\r\n  mounted() {\r\n    this.scrollToBottom();\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.ms-in {\r\n  width: 65vw;\r\n}\r\n\r\n.chat-bgcolor {\r\n  height: 65vh;\r\n  background-color: #ffffff;\r\n  overflow-y: auto;\r\n  margin: 1.5vh 1vw;\r\n  border-radius: 12px;\r\n  padding: 1.5vw;\r\n  box-sizing: border-box;\r\n  display: flex;\r\n  flex-direction: column;\r\n  box-shadow: 0 0.2vw 0.8vw rgba(0, 0, 0, 0.08);\r\n  border: 1px solid #ebeef5;\r\n  flex: 1;\r\n}\r\n\r\n.message-item {\r\n  margin-bottom: 1.5vh;\r\n  display: flex;\r\n  padding: 0.5vh 0;\r\n}\r\n\r\n/* 当前用户消息样式 (右侧) */\r\n.message-item.current-user {\r\n  justify-content: flex-end;\r\n}\r\n\r\n.current-user .message-content {\r\n  flex-direction: row-reverse;\r\n}\r\n\r\n.current-user .message-bubble {\r\n  background-color: #409EFF;\r\n  color: white;\r\n  border-radius: 18px 18px 0 18px;\r\n  margin-right: 0.8vw;\r\n  box-shadow: 0 0.1vw 0.3vw rgba(0, 0, 0, 0.1);\r\n}\r\n\r\n.current-user .message-time {\r\n  color: rgba(255, 255, 255, 0.7);\r\n}\r\n\r\n/* 其他用户消息样式 (左侧) */\r\n.message-item.other-user {\r\n  justify-content: flex-start;\r\n}\r\n\r\n.other-user .message-content {\r\n  flex-direction: row;\r\n}\r\n\r\n.other-user .message-bubble {\r\n  background-color: #f5f7fa;\r\n  color: #303133;\r\n  border-radius: 18px 18px 18px 0;\r\n  margin-left: 0.8vw;\r\n  box-shadow: 0 0.1vw 0.3vw rgba(0, 0, 0, 0.08);\r\n  border: 1px solid #ebeef5;\r\n}\r\n\r\n.other-user .message-time {\r\n  color: #909399;\r\n}\r\n\r\n.message-content {\r\n  display: flex;\r\n  max-width: 30vw;\r\n}\r\n\r\n.message-avatar {\r\n  display: flex;\r\n  align-items: flex-end;\r\n}\r\n\r\n.message-bubble {\r\n  padding: 0.625vw 0.8333vw;\r\n  position: relative;\r\n  word-break: break-word;\r\n}\r\n\r\n.message-text {\r\n  margin: 0;\r\n  font-size: 14px;\r\n  line-height: 1.5;\r\n}\r\n\r\n.message-time {\r\n  font-size: 11px;\r\n  margin-top: 0.2083vw;\r\n  text-align: right;\r\n}\r\n\r\n/* 输入框样式 */\r\n.el-input {\r\n  height: 6vh;\r\n  background: #ffffff;\r\n  border-radius: 20px;\r\n  box-shadow: 0 0.1042vw 0.5208vw rgba(0, 0, 0, 0.08);\r\n}\r\n\r\n.chat-header {\r\n  padding: 1.5vh 1.5vw;\r\n  background: #fff;\r\n  position: sticky;\r\n  top: 0;\r\n  z-index: 1;\r\n  box-shadow: 0 0.1vw 0.4vw rgba(0, 0, 0, 0.08);\r\n  border-radius: 12px;\r\n  margin: 1vh 1vw;\r\n  border: 1px solid #ebeef5;\r\n}\r\n\r\n.message-input {\r\n  font-family: '黑体';\r\n  display: flex;\r\n  flex-direction: column;\r\n  margin: 1.5vh 1vw;\r\n  padding: 1vw;\r\n  width: 64.9vw;\r\n  background: #ffffff;\r\n  border-radius: 12px;\r\n  box-shadow: 0 0.1vw 0.4vw rgba(0, 0, 0, 0.08);\r\n  border: 1px solid #ebeef5;\r\n  gap: 0.8vw;\r\n  /* 新增样式使容器向上拉伸 */\r\n  position: relative;\r\n  bottom: 0;\r\n  z-index: 100;\r\n}\r\n\r\n.el-textarea__inner {\r\n  resize: none;\r\n  align-items: flex-end;\r\n}\r\n\r\n:deep(.el-textarea__inner) {\r\n  box-shadow: none;\r\n  padding: 10px;\r\n  border: none;\r\n  resize: none;\r\n  overflow-y: auto;\r\n}\r\n\r\n.send_Message_css {\r\n  align-self: flex-end\r\n}\r\n\r\n/* 优化滚动条样式 */\r\n:deep(.el-scrollbar__bar.is-vertical) {\r\n  width: 6px;\r\n}\r\n\r\n:deep(.el-scrollbar__thumb) {\r\n  background-color: rgba(144, 147, 153, 0.3);\r\n  &:hover {\r\n    background-color: rgba(144, 147, 153, 0.5);\r\n  }\r\n}\r\n</style>"],"mappings":"AA8CA,SAASA,iBAAgB,QAAS,kBAAkB;AACpD,SAASC,QAAO,QAAS,KAAK;AAC9B,eAAe;EACbC,IAAI,EAAE,2BAA2B;EACjCC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,OAAO,EAAE,EAAE;MACXC,UAAU,EAAE,IAAI,CAAE;IACpB;EACF,CAAC;EACDC,QAAQ,EAAE;IACRC,UAAUA,CAAA,EAAG;MACX,IAAI,CAAC,IAAI,CAACC,MAAM,CAACC,KAAK,CAACC,WAAW,EAAE,OAAO;QAAEC,IAAI,EAAE,MAAM;QAAEC,IAAI,EAAE;MAAK,CAAC;MACvE,MAAMC,QAAO,GAAI,IAAI,CAACL,MAAM,CAACC,KAAK,CAACK,cAAc,CAACC,QAAQ,CAAC,IAAI,CAACP,MAAM,CAACC,KAAK,CAACC,WAAW,CAAC;MACzF,OAAO;QACLC,IAAI,EAAEE,QAAO,GAAI,SAAQ,GAAI,MAAM;QACnCD,IAAI,EAAEC,QAAO,GAAI,IAAG,GAAI;MAC1B,CAAC;IACH;EACF,CAAC;EACDG,OAAO,EAAE;IACPC,WAAWA,CAAA,EAAG;MACZ,IAAI,CAAC,IAAI,CAACb,OAAO,CAACc,IAAI,CAAC,CAAC,EAAE;MAE1BlB,iBAAiB,CAAC,IAAI,CAACI,OAAO,EAAE,IAAI,CAACI,MAAM,CAACC,KAAK,CAACC,WAAW;MAC7D,IAAI,CAACN,OAAM,GAAI,EAAE;MACjB,