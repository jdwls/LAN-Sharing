{"ast":null,"code":"import io from \"socket.io-client\";\nexport default {\n  name: \"IsOlineNumber\",\n  mounted() {\n    // 创建一个 WebSocket 连接\n    this.socket = io(\"http://localhost:2525\");\n\n    // 监听 'onlineUsers' 事件\n    this.socket.on(\"onlineUsers\", data => {\n      console.log(\"在线用户数量:\", data);\n      // 在这里可以处理在线用户数量的变化\n      // 例如，更新组件的状态或触发其他操作\n    });\n  }\n};","map":{"version":3,"names":["io","name","mounted","socket","on","data","console","log"],"sources":["F:\\Windows\\Desktop\\code\\restvue003\\src\\components\\ChatRoom\\UrseLIst\\IsOlineNumber.vue"],"sourcesContent":["<template>\n  <div>11</div>\n</template>\n\n<script>\nimport io from \"socket.io-client\";\nexport default {\n  name: \"IsOlineNumber\",\n  mounted() {\n    // 创建一个 WebSocket 连接\n    this.socket = io(\"http://localhost:2525\");\n\n    // 监听 'onlineUsers' 事件\n    this.socket.on(\"onlineUsers\", (data) => {\n      console.log(\"在线用户数量:\", data);\n      // 在这里可以处理在线用户数量的变化\n      // 例如，更新组件的状态或触发其他操作\n    });\n  },\n};\n</script>\n"],"mappings":"AAKA,OAAOA,EAAC,MAAO,kBAAkB;AACjC,eAAe;EACbC,IAAI,EAAE,eAAe;EACrBC,OAAOA,CAAA,EAAG;IACR;IACA,IAAI,CAACC,MAAK,GAAIH,EAAE,CAAC,uBAAuB,CAAC;;IAEzC;IACA,IAAI,CAACG,MAAM,CAACC,EAAE,CAAC,aAAa,EAAGC,IAAI,IAAK;MACtCC,OAAO,CAACC,GAAG,CAAC,SAAS,EAAEF,IAAI,CAAC;MAC5B;MACA;IACF,CAAC,CAAC;EACJ;AACF,CAAC"},"metadata":{},"sourceType":"module","externalDependencies":[]}