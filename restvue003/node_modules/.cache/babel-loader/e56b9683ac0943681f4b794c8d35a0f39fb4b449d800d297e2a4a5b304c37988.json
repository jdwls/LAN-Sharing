{"ast":null,"code":"import LoginButton from \"@/components/ViewLogIn/LoginButton.vue\";\nimport LogupButton from \"@/components/ViewLogup/LogupButton.vue\";\nexport default {\n  name: \"HomePages\",\n  components: {\n    LoginButton,\n    LogupButton\n  },\n  data() {\n    return {\n      isListVisible: false // 控制列表显示的状态\n    };\n  },\n  methods: {\n    stteing() {\n      this.$store.state.FilesTyoes = \"设置\";\n      this.$store.state.dialogVisible = true;\n    }\n    // 移除了Lanshare方法\n  }\n};","map":{"version":3,"names":["LoginButton","LogupButton","name","components","data","isListVisible","methods","stteing","$store","state","FilesTyoes","dialogVisible"],"sources":["F:\\Windows\\Desktop\\code\\restvue003\\src\\components\\Home\\HomePages.vue"],"sourcesContent":["<template>\r\n  <div class=\"homePages\">\r\n    <!-- 其他代码保持不变 -->\r\n\r\n    <!-- 添加控制按钮 -->\r\n    <button class=\"toggle-btn\" @click=\"isListVisible = !isListVisible\">\r\n      {{ isListVisible ? \"点击隐藏列表\" : \"点击显示列表\" }}\r\n    </button>\r\n\r\n    <!-- 使用v-show控制列表显示 -->\r\n    <div v-show=\"isListVisible\">\r\n      <ul id=\"myList\">\r\n        <li>列表项 1</li>\r\n        <li>列表项 2</li>\r\n        <li>列表项 3</li>\r\n      </ul>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport LoginButton from \"@/components/ViewLogIn/LoginButton.vue\";\r\nimport LogupButton from \"@/components/ViewLogup/LogupButton.vue\";\r\n\r\nexport default {\r\n  name: \"HomePages\",\r\n  components: {\r\n    LoginButton,\r\n    LogupButton,\r\n  },\r\n  data() {\r\n    return {\r\n      isListVisible: false, // 控制列表显示的状态\r\n    };\r\n  },\r\n  methods: {\r\n    stteing() {\r\n      this.$store.state.FilesTyoes = \"设置\";\r\n      this.$store.state.dialogVisible = true;\r\n    },\r\n    // 移除了Lanshare方法\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n/* 添加按钮样式 */\r\n.toggle-btn {\r\n  padding: 8px 16px;\r\n  background-color: #1d85ed;\r\n  color: white;\r\n  border: none;\r\n  border-radius: 4px;\r\n  cursor: pointer;\r\n  display: block;\r\n  margin: 20px auto;\r\n  transition: background-color 0.3s;\r\n}\r\n\r\n.toggle-btn:hover {\r\n  background-color: #1565c0;\r\n}\r\n\r\n/* 列表样式 */\r\n#myList {\r\n  background-color: #f5f7fa;\r\n  border-radius: 8px;\r\n  padding: 15px;\r\n  width: 200px;\r\n  margin: 0 auto;\r\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);\r\n}\r\n\r\n#myList li {\r\n  padding: 8px 0;\r\n  border-bottom: 1px solid #ebeef5;\r\n  list-style-type: none;\r\n}\r\n\r\n#myList li:last-child {\r\n  border-bottom: none;\r\n}\r\n\r\n/* 其他样式保持不变 */\r\n.icon:hover {\r\n  transform: scale(1.2);\r\n  cursor: pointer;\r\n}\r\n.Title {\r\n  text-align: center;\r\n}\r\n.Title1 {\r\n  display: flex;\r\n  justify-content: space-around;\r\n}\r\n</style>\r\n"],"mappings":"AAqBA,OAAOA,WAAU,MAAO,wCAAwC;AAChE,OAAOC,WAAU,MAAO,wCAAwC;AAEhE,eAAe;EACbC,IAAI,EAAE,WAAW;EACjBC,UAAU,EAAE;IACVH,WAAW;IACXC;EACF,CAAC;EACDG,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,aAAa,EAAE,KAAK,CAAE;IACxB,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACPC,OAAOA,CAAA,EAAG;MACR,IAAI,CAACC,MAAM,CAACC,KAAK,CAACC,UAAS,GAAI,IAAI;MACnC,IAAI,CAACF,MAAM,CAACC,KAAK,CAACE,aAAY,GAAI,IAAI;IACxC;IACA;EACF;AACF,CAAC"},"metadata":{},"sourceType":"module","externalDependencies":[]}