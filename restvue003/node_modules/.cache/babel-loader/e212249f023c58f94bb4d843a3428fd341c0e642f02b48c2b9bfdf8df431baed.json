{"ast":null,"code":"export default {\n  name: 'ClickShowProgress',\n  computed: {\n    Is_showProgress() {\n      if (this.$store.state.upadaFileNumberSum - 1 == this.$store.state.files.length) {\n        return false;\n      } else {\n        return true;\n      }\n    }\n  },\n  methods: {\n    showProgress() {\n      this.$store.state.FilesTyoes = '进度条';\n      this.$store.state.dialogVisible = true;\n    }\n  }\n};","map":{"version":3,"names":["name","computed","Is_showProgress","$store","state","upadaFileNumberSum","files","length","methods","showProgress","FilesTyoes","dialogVisible"],"sources":["E:\\桌面\\code\\restvue003\\src\\components\\Common\\VueCommon\\ClickShowProgress.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <el-button @click=\"showProgress\" type=\"primary\" round v-if=Is_showProgress()>点击显示进度条</el-button>\r\n    <h4>当前文件上传总数为{{ $store.state.upadaFileNumberSum }}个文件,已经上传{{ $store.state.files.length }}个文件</h4>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'ClickShowProgress',\r\n  computed: {\r\n    Is_showProgress() {\r\n      if (this.$store.state.upadaFileNumberSum - 1 == this.$store.state.files.length) {\r\n        return false\r\n      } else {\r\n        return true\r\n      }\r\n    }\r\n  },\r\n  methods: {\r\n    showProgress() {\r\n      this.$store.state.FilesTyoes = '进度条';\r\n      this.$store.state.dialogVisible = true;\r\n    }\r\n  },\r\n\r\n}\r\n</script>\r\n"],"mappings":"AAQA,eAAe;EACbA,IAAI,EAAE,mBAAmB;EACzBC,QAAQ,EAAE;IACRC,eAAeA,CAAA,EAAG;MAChB,IAAI,IAAI,CAACC,MAAM,CAACC,KAAK,CAACC,kBAAiB,GAAI,KAAK,IAAI,CAACF,MAAM,CAACC,KAAK,CAACE,KAAK,CAACC,MAAM,EAAE;QAC9E,OAAO,KAAI;MACb,OAAO;QACL,OAAO,IAAG;MACZ;IACF;EACF,CAAC;EACDC,OAAO,EAAE;IACPC,YAAYA,CAAA,EAAG;MACb,IAAI,CAACN,MAAM,CAACC,KAAK,CAACM,UAAS,GAAI,KAAK;MACpC,IAAI,CAACP,MAAM,CAACC,KAAK,CAACO,aAAY,GAAI,IAAI;IACxC;EACF;AAEF"},"metadata":{},"sourceType":"module","externalDependencies":[]}