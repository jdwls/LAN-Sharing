{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport axios from 'axios';\nimport DiaLog from \"@/components/DiaLog.vue\";\nimport HomePages from \"@/components/Home/HomePages.vue\";\nexport default {\n  name: \"App\",\n  components: {\n    DiaLog,\n    HomePages\n  },\n  mounted() {\n    localStorage.getItem(\"UresName\");\n    axios({\n      url: this.$store.state.api + '/Toker',\n      method: \"get\",\n      params: {\n        Time: localStorage.getItem(\"Time\"),\n        Name: localStorage.getItem(\"UresName\")\n      }\n    }).then(res => {\n      if (res.data[1].message == '登录成功' && localStorage.getItem(\"Authority\") == 'Ures') {\n        this.$store.state.ButtonAuthority = [{\n          LoginButton: false\n        }, {\n          LogupButton: false\n        }, {\n          steeingButton: false\n        }, {\n          HeadIcon: true\n        }, {\n          LanShareView: true\n        }, {\n          DirsFileList: true\n        }];\n      } else if (res.data[1].message == '登录成功' && localStorage.getItem(\"Authority\") == 'Admin') {\n        this.$store.state.ButtonAuthority = [{\n          LoginButton: false\n        }, {\n          LogupButton: true\n        }, {\n          steeingButton: true\n        }, {\n          HeadIcon: true\n        }, {\n          LanShareView: true\n        }, {\n          DirsFileList: true\n        }];\n      } else {\n        localStorage.removeItem('Authority');\n        localStorage.removeItem('Time');\n        localStorage.removeItem('UresName');\n        this.$store.state.ButtonAuthority = [{\n          LoginButton: true\n        }, {\n          LogupButton: false\n        }, {\n          steeingButton: false\n        }, {\n          HeadIcon: false\n        }, {\n          LanShareView: false\n        }, {\n          DirsFileList: false\n        }];\n        this.$router.push('/');\n      }\n    }).catch(err => {\n      console.log(err);\n    });\n  }\n};","map":{"version":3,"names":["axios","DiaLog","