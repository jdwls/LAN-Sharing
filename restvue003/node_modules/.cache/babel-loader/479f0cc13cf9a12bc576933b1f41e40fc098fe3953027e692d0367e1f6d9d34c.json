\n      this.$store.state.ButtonAuthority=[\r\n        {LoginButton:true},\r\n        {LogupButton:false},\r\n        {steeingButton:false},\r\n        {HeadIcon:false},\r\n        {LanShareView:false}, \r\n        {DirsFileList:false}]\r\n      this.$router.push('/')  \r\n    }\r\n  })\r\n  .catch(err=>{\r\n    console.log(err);\r\n  })\r\n},  \r\n}\r\n</script>\r\n<style>\r\n#app {\r\n  width: 100%;\r\n  height: 100%;\r\n}\r\n.App {\r\n  width: 99%;\r\n  height: 100%;\r\n  display: flex;\r\n  margin-top: 1vh;\r\n}\r\n.HomePages {\r\n  width: 17vw;\r\n  height: 99vh;\r\n  background-color: coral;\r\n}\r\n.list-FlieList {\r\n  width: 80%;\r\n  height: 100%;\r\n}\r\n.toolbar-table {\r\n  width: auto;\r\n  height: 8vh;\r\n  display: flex;\r\n  justify-content: center;\r\n  gap: 3vw;\r\n}\r\n.Dirpath {\r\n  text-align: center;\r\n}\r\n</style>\r\n"],"mappings":";AAYA,OAAOA,KAAI,MAAO,OAAM;AACxB,OAAOC,MAAK,MAAO,yBAAyB;AAC5C,OAAOC,SAAQ,MAAO,iCAAiC;AACvD,eAAe;EACbC,IAAI,EAAE,KAAK;EACXC,UAAU,EAAE;IACVH,MAAM;IACNC;EACF,CAAC;EACHG,OAAOA,CAAA,EAAG;IACRC,YAAY,CAACC,OAAO,CAAC,UAAU;IAC/BP,KAAK,CAAC;MACJQ,GAAG,EAAC,IAAI,CAACC,MAAM,CAACC,KAAK,CAACC,GAAG,GAAC,QAAQ;MAClCC,MAAM,EAAC,KAAK;MACZC,MAAM,EAAC;QACLC,IAAI,EAACR,YAAY,CAACC,OAAO,CAAC,MAAM,CAAC;QACjCQ,IAAI,EAACT,YAAY,CAACC,OAAO,CAAC,UAAU;MACtC;IACF,CAAC,EACAS,IAAI,CAACC,GAAG,IAAE;MACT,IAAGA,GAAG,CAACC,IAAI,CAAC,CAAC,CAAC,CAACC,OAAO,IAAE,MAAK,IAAKb,YAAY,CAACC,OAAO,CAAC,WAAW,CAAC,IAAE,MAAM,EAAC;QAC1E,IAAI,CAACE,MAAM,CAACC,KAAK,CAACU,eAAe,GAAC,CAChC;UAACC,WAAW,EAAC;QAAK,CAAC,EACnB;UAACC,WAAW,EAAC;QAAK,CAAC,EACnB;UAACC,aAAa,EAAC;QAAK,CAAC,EACrB;UAACC,QAAQ,EAAC;QAAI,CAAC,EACf;UAACC,YAAY,EAAC;QAAI,CAAC,EACnB;UAACC,YAAY,EAAC;QAAI,CAAC;MACvB,OACK,IAAGT,GAAG,CAACC,IAAI,CAAC,CAAC,CAAC,CAACC,OAAO,IAAE,MAAK,IAAKb,YAAY,CAACC,OAAO,CAAC,WAAW,CAAC,IAAE,OAAO,EAAC;QAChF,IAAI,CAACE,MAAM,CAACC,KAAK,CAACU,eAAe,GAAC,CAChC;UAACC,WAAW,EAAC;QAAK,CAAC,EACnB;UAACC,WAAW,EAAC;QAAI,CAAC,EAClB;UAACC,aAAa,EAAC;QAAI,CAAC,EACpB;UAACC,QAAQ,EAAC;QAAI,CAAC,EACf;UAA