{"ast":null,"code":"import UserListSection from \"./UserListSection.vue\";\nconst DEFAULT_AVATAR = \"https://cube.elemecdn.com/0/88/03b0d39583f48206768a7534e55bcpng.png\";\nexport default {\n  name: \"UrseList\",\n  components: {\n    UserListSection\n  },\n  data() {\n    return {\n      defaultAvatar: DEFAULT_AVATAR,\n      currentUserName: localStorage.getItem(\"UresName\"),\n      allUsers: [] // 实际应从store或API获取\n    };\n  },\n  computed: {\n    onlineUsers() {\n      return this.allUsers.filter(user => user.status === \"online\");\n    },\n    offlineUsers() {\n      return this.allUsers.filter(user => user.status === \"offline\");\n    }\n  },\n  async created() {\n    // 这里应该从store或API获取真实用户数据\n    // this.allUsers = await this.$store.dispatch('fetchUsers')\n  }\n};","map":{"version":3,"names":["UserListSection","DEFAULT_AVATAR","name","components","data","defaultAvatar","currentUserName","localStorage","getItem","allUsers","computed","onlineUsers","filter","user","status","offlineUsers","created"],"sources":["F:\\Windows\\Desktop\\code\\restvue003\\src\\components\\ChatRoom\\UrseLIst\\UrseLIst.vue"],"sourcesContent":["<template>\r\n  <div class=\"user-list-container\">\r\n    <div class=\"header\">\r\n      <el-avatar\r\n        shape=\"square\"\r\n        :src=\"defaultAvatar\"\r\n        v-if=\"$store.state.ButtonAuthority[3].HeadIcon\"\r\n      ></el-avatar>\r\n      <h1>{{ currentUserName }}</h1>\r\n    </div>\r\n\r\n    <div class=\"user-list-body\">\r\n      <UserListSection\r\n        title=\"在线人数\"\r\n        :count=\"onlineUsers.length\"\r\n        :users=\"onlineUsers\"\r\n      />\r\n\r\n      <UserListSection\r\n        title=\"离线人数\"\r\n        :count=\"offlineUsers.length\"\r\n        :users=\"offlineUsers\"\r\n      />\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport UserListSection from \"./UserListSection.vue\";\r\n\r\nconst DEFAULT_AVATAR =\r\n  \"https://cube.elemecdn.com/0/88/03b0d39583f48206768a7534e55bcpng.png\";\r\n\r\nexport default {\r\n  name: \"UrseList\",\r\n  components: { UserListSection },\r\n  data() {\r\n    return {\r\n      defaultAvatar: DEFAULT_AVATAR,\r\n      currentUserName: localStorage.getItem(\"UresName\"),\r\n      allUsers: [], // 实际应从store或API获取\r\n    };\r\n  },\r\n  computed: {\r\n    onlineUsers() {\r\n      return this.allUsers.filter((user) => user.status === \"online\");\r\n    },\r\n    offlineUsers() {\r\n      return this.allUsers.filter((user) => user.status === \"offline\");\r\n    },\r\n  },\r\n  async created() {\r\n    // 这里应该从store或API获取真实用户数据\r\n    // this.allUsers = await this.$store.dispatch('fetchUsers')\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.user-list-container {\r\n  padding: 16px;\r\n}\r\n\r\n.header {\r\n  display: flex;\r\n  align-items: center;\r\n  margin-bottom: 24px;\r\n}\r\n\r\n.header h1 {\r\n  margin-left: 12px;\r\n  font-size: 18px;\r\n}\r\n\r\n.user-list-body {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 16px;\r\n}\r\n</style>\r\n"],"mappings":"AA4BA,OAAOA,eAAc,MAAO,uBAAuB;AAEnD,MAAMC,cAAa,GACjB,qEAAqE;AAEvE,eAAe;EACbC,IAAI,EAAE,UAAU;EAChBC,UAAU,EAAE;IAAEH;EAAgB,CAAC;EAC/BI,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,aAAa,EAAEJ,cAAc;MAC7BK,eAAe,EAAEC,YAAY,CAACC,OAAO,CAAC,UAAU,CAAC;MACjDC,QAAQ,EAAE,EAAE,CAAE;IAChB,CAAC;EACH,CAAC;EACDC,QAAQ,EAAE;IACRC,WAAWA,CAAA,EAAG;MACZ,OAAO,IAAI,CAACF,QAAQ,CAACG,MAAM,CAAEC,IAAI,IAAKA,IAAI,CAACC,MAAK,KAAM,QAAQ,CAAC;IACjE,CAAC;IACDC,YAAYA,CAAA,EAAG;MACb,OAAO,IAAI,CAACN,QAAQ,CAACG,MAAM,CAAEC,IAAI,IAAKA,IAAI,CAACC,MAAK,KAAM,SAAS,CAAC;IAClE;EACF,CAAC;EACD,MAAME,OAAOA,CAAA,EAAG;IACd;IACA;EAAA;AAEJ,CAAC"},"metadata":{},"sourceType":"module","externalDependencies":[]}