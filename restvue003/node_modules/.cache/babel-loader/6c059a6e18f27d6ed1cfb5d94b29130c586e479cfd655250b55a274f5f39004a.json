{"ast":null,"code":"import axios from \"axios\";\nimport { ElMessageBox } from \"element-plus\";\nexport default {\n  name: \"NewText\",\n  data() {\n    return {\n      TextName: \"\",\n      TextConter: \"\"\n    };\n  },\n  methods: {\n    async onSubmit() {\n      if (this.TextName != \"\") {\n        ElMessageBox.alert(\"是否创建\" + this.TextName + \"的文本文件\", \"是否确认创建文本文件\", {\n          showConfirmButton: true,\n          showCancelButton: true,\n          confirmButtonText: \"确认\",\n          cancelButtonText: \"取消\"\n        }).catch(() => {\n          console.log(\"成功取消\");\n        }).then(async () => {\n          axios({\n            method: \"get\",\n            url: this.$store.state.api + \"/TextLnsert\",\n            params: {\n              TextName: this.TextName,\n              TextConter: this.TextConter,\n              NowPath: this.$store.state.DirPath\n            }\n          }).then(res => {\n            if (res.data.message == \"创建文本文件成功\") {\n              this.$store.dispatch(\"DirsFileList\");\n              ElMessageBox.alert(res.data.message, \"创建文本状态\", {\n                showConfirmButton: true,\n                showCancelButton: true,\n                confirmButtonText: \"再来一个\",\n                cancelButtonText: \"取消\"\n              }).catch(() => {\n                this.$store.state.dialogVisible = false;\n              });\n            } else if (res.data.message == \"当前存在相关文件\") {\n              ElMessageBox.alert(res.data.message, \"创建文本状态\", {\n                showConfirmButton: true,\n                showCancelButton: true,\n                confirmButtonText: \"再来一个\",\n                cancelButtonText: \"取消\"\n              }).catch(() => {\n                this.$store.state.dialogVisible = false;\n              }).then(() => {\n                this.TextName = \"\";\n                this.TextConter = \"\";\n              });\n            } else if (res.data.message == \"创建文本文件失败\") {\n              ElMessageBox.alert(res.data.message, \"创建文本状态\", {\n                showConfirmButton: true,\n                showCancelButton: true,\n                confirmButtonText: \"再来一个\",\n                cancelButtonText: \"取消\"\n              }).catch(() => {\n                this.$store.state.dialogVisible = false;\n              }).then(() => {\n                this.TextName = \"\";\n                this.TextConter = \"\";\n              });\n            }\n          });\n        });\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","ElMessageBox","name","data","TextName","TextConter","methods","onSubmit","alert","showConfirmButton","showCancelButton","confirmButtonText","cancelButtonText","catch","console","log","then","method","url","$store","state","api","params","NowPath","DirPath","res","message","dispatch","dialogVisible"],"sources":["F:\\Windows\\Desktop\\code\\restvue003\\src\\components\\NewText.vue"],"sourcesContent":["<template>\n  <div>\n    <el-form label-position=\"left\">\n      <div>\n        <el-form-item label=\"文本名称:\" style=\"max-width: 70%\">\n          <el-input v-model=\"TextName\" />\n        </el-form-item>\n      </div>\n\n      <div>\n        <el-form-item label=\"文本内容:\" style=\"max-width: 70%\">\n          <el-input type=\"textarea\" v-model=\"TextConter\" />\n        </el-form-item>\n      </div>\n    </el-form>\n    <div class=\"onSubmitbutton\">\n      <!-- <el-button type=\"primary\" @click=\"onSubmit\">确认</el-button> -->\n      <el-button type=\"primary\" :plain=\"true\" @click=\"onSubmit\">确认</el-button>\n    </div>\n  </div>\n</template>\n<script>\nimport axios from \"axios\";\nimport { ElMessageBox } from \"element-plus\";\nexport default {\n  name: \"NewText\",\n  data() {\n    return {\n      TextName: \"\",\n      TextConter: \"\",\n    };\n  },\n  methods: {\n    async onSubmit() {\n      if (this.TextName != \"\") {\n        ElMessageBox.alert(\n          \"是否创建\" + this.TextName + \"的文本文件\",\n          \"是否确认创建文本文件\",\n          {\n            showConfirmButton: true,\n            showCancelButton: true,\n            confirmButtonText: \"确认\",\n            cancelButtonText: \"取消\",\n          }\n        )\n          .catch(() => {\n            console.log(\"成功取消\");\n          })\n          .then(async () => {\n            axios({\n              method: \"get\",\n              url: this.$store.state.api + \"/TextLnsert\",\n              params: {\n                TextName: this.TextName,\n                TextConter: this.TextConter,\n                NowPath: this.$store.state.DirPath,\n              },\n            })\n            .then((res) => {\n                  if (res.data.message ==\"创建文本文件成功\") {\n                    this.$store.dispatch(\"DirsFileList\");\n                      ElMessageBox.alert(res.data.message, \"创建文本状态\", {\n                    showConfirmButton: true,\n                    showCancelButton: true,\n                    confirmButtonText: \"再来一个\",\n                    cancelButtonText: \"取消\",\n                  }).catch(() => {\n                    this.$store.state.dialogVisible = false;\n                })\n                  }\n                  else if(res.data.message == \"当前存在相关文件\") {\n                    ElMessageBox.alert(res.data.message, \"创建文本状态\", {\n                      showConfirmButton: true,\n                      showCancelButton: true,\n                      confirmButtonText: \"再来一个\",\n                      cancelButtonText: \"取消\",\n                    }).catch(() => {\n                      this.$store.state.dialogVisible = false;\n                    })\n                    .then(() => {\n                      this.TextName = \"\";\n                      this.TextConter = \"\";\n                    })\n                  }\n                  else if(res.data.message == \"创建文本文件失败\") {\n                    ElMessageBox.alert(res.data.message, \"创建文本状态\", {\n                      showConfirmButton: true,\n                      showCancelButton: true,\n                      confirmButtonText: \"再来一个\",\n                      cancelButtonText: \"取消\",\n                    }).catch(() => {\n                      this.$store.state.dialogVisible = false; \n                    })\n                    .then(() => {\n                      this.TextName = \"\";\n                      this.TextConter = \"\";\n                    })\n                  }\n                  \n            })\n          })\n      } \n        \n      \n    },\n  },\n};\n</script>\n<style scoped>\n.el-form-item {\n  /* padding-top: 1%;    */\n  margin: 0 auto;\n  margin-top: 1%;\n}\n.onSubmitbutton {\n  display: flex;\n  justify-content: center;\n  margin-top: 1%;\n}\n</style>\n"],"mappings":"AAsBA,OAAOA,KAAI,MAAO,OAAO;AACzB,SAASC,YAAW,QAAS,cAAc;AAC3C,eAAe;EACbC,IAAI,EAAE,SAAS;EACfC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,EAAE;MACZC,UAAU,EAAE;IACd,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,QAAQA,CAAA,EAAG;MACf,IAAI,IAAI,CAACH,QAAO,IAAK,EAAE,EAAE;QACvBH,YAAY,CAACO,KAAK,CAChB,MAAK,GAAI,IAAI,CAACJ,QAAO,GAAI,OAAO,EAChC,YAAY,EACZ;UACEK,iBAAiB,EAAE,IAAI;UACvBC,gBAAgB,EAAE,IAAI;UACtBC,iBAAiB,EAAE,IAAI;UACvBC,gBAAgB,EAAE;QACpB,CACF,EACGC,KAAK,CAAC,MAAM;UACXC,OAAO,CAACC,GAAG,CAAC,MAAM,CAAC;QACrB,CAAC,EACAC,IAAI,CAAC,YAAY;UAChBhB,KAAK,CAAC;YACJiB,MAAM,EAAE,KAAK;YACbC,GAAG,EAAE,IAAI,CAACC,MAAM,CAACC,KAAK,CAACC,GAAE,GAAI,aAAa;YAC1CC,MAAM,EAAE;cACNlB,QAAQ,EAAE,IAAI,CAACA,QAAQ;cACvBC,UAAU,EAAE,IAAI,CAACA,UAAU;cAC3BkB,OAAO,EAAE,IAAI,CAACJ,MAAM,CAACC,KAAK,CAACI;YAC7B;UACF,CAAC,EACAR,IAAI,CAAES,GAAG,IAAK;YACT,IAAIA,GAAG,CAACtB,IAAI,CAACuB,OAAM,IAAI,UAAU,EAAE;cACjC,IAAI,CAACP,MAAM,CAACQ,QAAQ,CAAC,cAAc,CAAC;cAClC1B,YAAY,CAACO,KAAK,CAACiB,GAAG,CAACtB,IAAI,CAACuB,OAAO,EAAE,QAAQ,EAAE;gBACjDjB,iBAAiB,EAAE,IAAI;gBACvBC,gBAAgB,EAAE,IAAI;gBACtBC,iBAAiB,EAAE,MAAM;gBACzBC,gBAAgB,EAAE;cACpB,CAAC,CAAC,CAACC,KAAK,CAAC,MAAM;gBACb,IAAI,CAACM,MAAM,CAACC,KAAK,CAACQ,aAAY,GAAI,KAAK;cAC3C,CAAC;YACC,OACK,IAAGH,GAAG,CAACtB,IAAI,CAACuB,OAAM,IAAK,UAAU,EAAE;cACtCzB,YAAY,CAACO,KAAK,CAACiB,GA