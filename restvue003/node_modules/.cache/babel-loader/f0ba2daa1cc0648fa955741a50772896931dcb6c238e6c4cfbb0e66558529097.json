plate>\r\n            </el-table-column>\r\n          </el-table-column>\r\n        </el-table-column>\r\n      </el-table>\r\n      <el-pagination\r\n        class=\"pagination\"\r\n        background\r\n        @size-change=\"handleSizeChange\"\r\n        @current-change=\"handleCurrentChange\"\r\n        :current-page=\"currentPage1\"\r\n        :page-sizes=\"[10, 50, 100, 1000]\"\r\n        :page-size=\"pageSize\"\r\n        layout=\"total, sizes, prev, pager, next, jumper\"\r\n        :total=\"filteredData.length\"\r\n      ></el-pagination>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport downloadFlie from \"../LanShareIndexButton/downloadFlie.vue\";\r\nimport dropFiles from \"../LanShareIndexButton/dropFiles.vue\";\r\nimport openDir from \"../LanShareIndexButton/openDir.vue\";\r\nimport ViewButton from \"../LanShareIndexButton/ViewButton.vue\";\r\n\r\nexport default {\r\n  name: \"DirsFileList\",\r\n  data() {\r\n    return {\r\n      currentPage1: 1,\r\n      pageSize: 10,\r\n      search: \"\",\r\n      appliedSearch: \"\",\r\n    };\r\n  },\r\n  components: {\r\n    downloadFlie,\r\n    dropFiles,\r\n    openDir,\r\n    ViewButton,\r\n  },\r\n  computed: {\r\n    filteredData() {\r\n      const keyword = this.appliedSearch.toLowerCase();\r\n      if (!keyword) return this.$store.state.DirsFileList;\r\n      return this.$store.state.DirsFileList.filter((item) =>\r\n        item.data.toLowerCase().includes(keyword)\r\n      );\r\n    },\r\n    currentPageData() {\r\n      const start = (this.currentPage1 - 1) * this.pageSize;\r\n      const end = start + this.pageSize;\r\n      return this.filteredData.slice(start, end);\r\n    },\r\n    luj() {\r\n      return `当前路径：${this.$store.state.DirPath}`;\r\n    },\r\n  },\r\n  mounted() {\r\n    this.$store.dispatch(\"Tokers\").then((res) => {\r\n      if (res == \"登录成功\") {\r\n        this.$store.dispatch(\"DirsFileList\");\r\n        this.$store.dispatch(\"OptionDir\");\r\n      } else {\r\n        this.$router.push(\"/\");\r\n      }\r\n    });\r\n  },\r\n  methods: {\r\n    handleSizeChange(val) {\r\n      this.pageSize = val;\r\n      this.currentPage1 = 1;\r\n    },\r\n    handleCurrentChange(val) {\r\n      this.currentPage1 = val;\r\n    },\r\n    handleSearch() {\r\n      this.appliedSearch = this.search;\r\n      this.currentPage1 = 1;\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.container {\r\n  padding: 2vh;\r\n  display: flex;\r\n  justify-content: center;\r\n}\r\n\r\n.table-pagination-wrapper {\r\n  width: 90vw;\r\n  max-width: 100vw;\r\n  margin: 0 auto;\r\n}\r\n\r\n.file-table {\r\n  width: 100%;\r\n  margin-bottom: 2vh;\r\n}\r\n\r\n.file-table :deep(.el-table__cell) {\r\n  padding: 1vh 0;\r\n}\r\n\r\n.search-container {\r\n  display: flex;\r\n  align-items: center;\r\n  padding: 1vh 0;\r\n}\r\n\r\n.search-input {\r\n  flex: 1;\r\n  max-width: 50vw;\r\n  margin-right: 1vw;\r\n}\r\n\r\n.search-btn {\r\n  flex-shrink: 0;\r\n}\r\n\r\n.action-buttons {\r\n  display: flex;\r\n  gap: 1vw;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.pagination {\r\n  margin-top: 2vh;\r\n  justify-content: center;\r\n}\r\n\r\n@media (max-width: 768px) {\r\n  .container {\r\n    padding: 1vh;\r\n  }\r\n  \r\n  .search-container {\r\n    flex-direction: column;\r\n    gap: 1vh;\r\n  }\r\n  \r\n  .search-input {\r\n    width: 80vw;\r\n    max-width: 80vw;\r\n    margin-right: 0;\r\n  }\r\n  \r\n  .action-buttons {\r\n    flex-direction: column;\r\n    gap: 0.5vh;\r\n  }\r\n  \r\n  .pagination :deep(.el-pagination__jump) {\r\n    display: none !important;\r\n  }\r\n}\r\n</style>\r\n"],"mappings":";AAiEA,OAAOA,YAAW,MAAO,yCAAyC;AAClE,OAAOC,SAAQ,MAAO,sCAAsC;AAC5D,OAAOC,OAAM,MAAO,oCAAoC;AACxD,OAAOC,UAAS,MAAO,uCAAuC;AAE9D,eAAe;EACbC,IAAI,EAAE,cAAc;EACpBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,YAAY,EAAE,CAAC;MACfC,QAAQ,EAAE,EAAE;MACZC,MAAM,EAAE,EAAE;MACVC,aAAa,EAAE;IACjB,CAAC;EACH,CAAC;EACDC,UAAU,EAAE;IACVV,YAAY;IACZC,SAAS;IACTC,OAAO;IACPC;EACF,CAAC;EACDQ,QAAQ,EAAE;IACRC,YAA