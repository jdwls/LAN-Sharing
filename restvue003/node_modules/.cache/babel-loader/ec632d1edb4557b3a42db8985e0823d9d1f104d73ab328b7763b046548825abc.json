{"ast":null,"code":"import axios from 'axios';\nexport default {\n  data() {\n    return {\n      isDisabled: false,\n      countdown: 0,\n      timer: null\n    };\n  },\n  methods: {\n    async topleveldirectory() {\n      if (this.isDisabled) return;\n      // 立即禁用按钮\n      this.startCountdown();\n      try {\n        await this.TopLevelDirectory();\n      } catch (error) {\n        console.error('操作失败:', error);\n      }\n    },\n    async TopLevelDirectory() {\n      console.log(this.$store.state.DirPath);\n      try {\n        const res = await axios.get(this.$store.state.api + '/TopLevelDirectory', {\n          params: {\n            TopLevelDirectoryPathName: this.$store.state.DirPath\n          }\n        });\n        if (res.data.type === '成功') {\n          let ds = '';\n          for (let i = 0; i < res.data.data.length - 1; i++) {\n            ds += res.data.data[i];\n          }\n          console.log(ds);\n          this.$store.state.DirPath = ds;\n          await Promise.all([this.$store.dispatch('DirsFileList')]);\n        }\n      } catch (error) {\n        console.error('目录操作失败:', error);\n      }\n    },\n    // async getDirs() {\n    //     const res = await axios.get(this.$store.state.api + '/getDirs');\n    //     return res.data.data;\n    // },\n\n    startCountdown() {\n      this.isDisabled = true;\n      this.countdown = 5;\n      this.timer = setInterval(() => {\n        this.countdown--;\n        if (this.countdown <= 0) {\n          clearInterval(this.timer);\n          this.isDisabled = false;\n        }\n      }, 1000);\n    }\n  },\n  beforeUnmount() {\n    if (this.timer) {\n      clearInterval(this.timer);\n    }\n  }\n};","map":{"version":3,"names":["axios","data","isDisabled","countdown","timer","methods","topleveldirectory","startCountdown","TopLevelDirectory","error","console","log","$store","state","DirPath","res","get","api","params","TopLevelDirectoryPathName","type","ds","i","length","Promise","all","dispatch","setInterval","clearInterval","beforeUnmount"],"sources":["F:\\Windows\\Desktop\\code\\restvue003\\src\\components\\TopLevelDirectory.vue"],"sourcesContent":["<template>\n    <div>\n        <el-button \n            :disabled=\"isDisabled\" \n            @click=\"topleveldirectory\" \n            class=\"tets\">\n            返回上级目录\n            <span v-if=\"countdown > 0\">({{ countdown }}s)</span>\n        </el-button>\n    </div>\n</template>\n\n<script>\nimport axios from 'axios';\n\nexport default {\n    data() {\n        return {\n            isDisabled: false,\n            countdown: 0,\n            timer: null\n        };\n    },\n    methods: {\n        async topleveldirectory() {\n            if (this.isDisabled) return;\n            // 立即禁用按钮\n            this.startCountdown();\n            \n            try {\n                await this.TopLevelDirectory();\n            } catch (error) {\n                console.error('操作失败:', error);\n            }\n        },\n\n        async TopLevelDirectory() {\n            console.log(this.$store.state.DirPath);\n            try {\n                const res = await axios.get(this.$store.state.api + '/TopLevelDirectory', \n                {\n                    params: { \n                        TopLevelDirectoryPathName: this.$store.state.DirPath \n                    }\n                });\n                \n                if(res.data.type === '成功') {\n                    let ds='';\n                    for(let i=0;i<(res.data.data.length)-1;i++){\n                       ds+=res.data.data[i];\n                    }\n                    console.log(ds);\n                    this.$store.state.DirPath = ds;\n                    await Promise.all([\n                        this.$store.dispatch('DirsFileList'),\n                    ]);\n                }\n            } catch (error) {\n                console.error('目录操作失败:', error);\n            }\n        },\n\n        // async getDirs() {\n        //     const res = await axios.get(this.$store.state.api + '/getDirs');\n        //     return res.data.data;\n        // },\n\n        startCountdown() {\n            this.isDisabled = true;\n            this.countdown = 5;\n            \n            this.timer = setInterval(() => {\n                this.countdown--;\n                \n                if (this.countdown <= 0) {\n                    clearInterval(this.timer);\n                    this.isDisabled = false;\n                }\n            }, 1000);\n        }\n    },\n    beforeUnmount() {\n        if (this.timer) {\n            clearInterval(this.timer);\n        }\n    }\n};\n</script>\n\n<style scoped>\n/* 禁用状态样式 */\n.el-button.is-disabled {\n    cursor: not-allowed;\n    opacity: 0.7;\n}\n</style>"],"mappings":"AAaA,OAAOA,KAAI,MAAO,OAAO;AAEzB,eAAe;EACXC,IAAIA,CAAA,EAAG;IACH,OAAO;MACHC,UAAU,EAAE,KAAK;MACjBC,SAAS,EAAE,CAAC;MACZC,KAAK,EAAE;IACX,CAAC;EACL,CAAC;EACDC,OAAO,EAAE;IACL,MAAMC,iBAAiBA,CAAA,EAAG;MACtB,IAAI,IAAI,CAACJ,UAAU,EAAE;MACrB;MACA,IAAI,CAACK,cAAc,CAAC,CAAC;MAErB,IAAI;QACA,MAAM,IAAI,CAACC,iBAAiB,CAAC,CAAC;MAClC,EAAE,OAAOC,KAAK,EAAE;QACZC,OAAO,CAACD,KAAK,CAAC,OAAO,EAAEA,KAAK,CAAC;MACjC;IACJ,CAAC;IAED,MAAMD,iBAAiBA,CAAA,EAAG;MACtBE,OAAO,CAACC,GAAG,CAAC,IAAI,CAACC,MAAM,CAACC,KAAK,CAACC,OAAO,CAAC;MACtC,IAAI;QACA,MAAMC,GAAE,GAAI,MAAMf,KAAK,CAACgB,GAAG,CAAC,IAAI,CAACJ,MAAM,CAACC,KAAK,CAACI,GAAE,GAAI,oBAAoB,EACxE;UACIC,MAAM,EAAE;YACJC,yBAAyB,EAAE,IAAI,CAACP,MAAM,CAACC,KAAK,CAACC;UACjD;QACJ,CAAC,CAAC;QAEF,IAAGC,GAAG,CAACd,IAAI,CAACmB,IAAG,KAAM,IAAI,EAAE;UACvB,IAAIC,EAAE,GAAC,EAAE;UACT,KAAI,IAAIC,CAAC,GAAC,CAAC,EAACA,CAAC,GAAEP,GAAG,CAACd,IAAI,CAACA,IAAI,CAACsB,MAAM,GAAE,CAAC,EAACD,CAAC,EAAE,EAAC;YACxCD,EAAE,IAAEN,GAAG,CAACd,IAAI,CAACA,IAAI,CAACqB,CAAC,CAAC;UACvB;UACAZ,OAAO,CAACC,GAAG,CAACU,EAAE,CAAC;UACf,IAAI,CAACT,MAAM,CAACC,KAAK,CAACC,OAAM,GAAIO,EAAE;UAC9B,MAAMG,OAAO,CAACC,GAAG,CAAC,CACd,IAAI,CAACb,MAAM,CAACc,QAAQ,CAAC,cAAc,CAAC,CACvC,CAAC;QACN;MACJ,EAAE,OAAOjB,KAAK,EAAE;QACZC,OAAO,CAACD,KAAK,CAAC,SAAS,EAAEA,KAAK,CAAC;MACnC