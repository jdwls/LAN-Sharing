{"ast":null,"code":"import axios from \"axios\";\nimport { ElMessageBox } from \"element-plus\";\nexport default {\n  name: \"dropFiles\",\n  props: [\"dropFiles\"],\n  methods: {\n    async dropFile(dropFiles) {\n      ElMessageBox.alert(\"是否删除\" + dropFiles + \"的文件\", \"是否确认删除文件\", {\n        showConfirmButton: true,\n        showCancelButton: true,\n        confirmButtonText: \"确认\",\n        cancelButtonText: \"取消\"\n      }).then(async () => {\n        axios({\n          method: \"get\",\n          url: this.$store.state.api + \"/dropFiles\",\n          params: {\n            dropFilesName: this.$store.state.DirPath + \"/\" + dropFiles\n          }\n        }).then(res => {\n          if (res.data.type == \"删除文件成功\") {\n            this.$store.dispatch(\"DirsFileList\");\n          }\n        });\n      }).catch(() => {\n        console.log(\"成功取消\");\n      });\n    }\n  }\n};","map":{"version":3,"names":["axios","ElMessageBox","name","props","methods","dropFile","dropFiles","alert","showConfirmButton","showCancelButton","confirmButtonText","cancelButtonText","then","method","url","$store","state","api","params","dropFilesName","DirPath","res","data","type","dispatch","catch","console","log"],"sources":["F:\\Windows\\Desktop\\code\\restvue003\\src\\components\\LanShare\\LanShareIndexButton\\dropFiles.vue"],"sourcesContent":["<template>\n  <div>\n    <el-button @click=\"dropFile(dropFiles)\" id=\"myButton\"> 删除文件</el-button>\n  </div>\n</template>\n\n<script>\nimport axios from \"axios\";\nimport { ElMessageBox } from \"element-plus\";\nexport default {\n  name: \"dropFiles\",\n\n  props: [\"dropFiles\"],\n  methods: {\n    async dropFile(dropFiles) {\n      ElMessageBox.alert(\n        \"是否删除\" + dropFiles + \"的文件\",\n        \"是否确认删除文件\",\n        {\n          showConfirmButton: true,\n          showCancelButton: true,\n          confirmButtonText: \"确认\",\n          cancelButtonText: \"取消\",\n        }\n      )\n        .then(async () => {\n          axios({\n            method: \"get\",\n            url: this.$store.state.api + \"/dropFiles\",\n            params: {\n              dropFilesName: this.$store.state.DirPath + \"/\" + dropFiles,\n            },\n          }).then((res) => {\n            if (res.data.type == \"删除文件成功\") {\n              this.$store.dispatch(\"DirsFileList\");\n            }\n          });\n        })\n        .catch(() => {\n          console.log(\"成功取消\");\n        });\n    },\n  },\n};\n</script>\n<style scoped></style>\n"],"mappings":"AAOA,OAAOA,KAAI,MAAO,OAAO;AACzB,SAASC,YAAW,QAAS,cAAc;AAC3C,eAAe;EACbC,IAAI,EAAE,WAAW;EAEjBC,KAAK,EAAE,CAAC,WAAW,CAAC;EACpBC,OAAO,EAAE;IACP,MAAMC,QAAQA,CAACC,SAAS,EAAE;MACxBL,YAAY,CAACM,KAAK,CAChB,MAAK,GAAID,SAAQ,GAAI,KAAK,EAC1B,UAAU,EACV;QACEE,iBAAiB,EAAE,IAAI;QACvBC,gBAAgB,EAAE,IAAI;QACtBC,iBAAiB,EAAE,IAAI;QACvBC,gBAAgB,EAAE;MACpB,CACF,EACGC,IAAI,CAAC,YAAY;QAChBZ,KAAK,CAAC;UACJa,MAAM,EAAE,KAAK;UACbC,GAAG,EAAE,IAAI,CAACC,MAAM,CAACC,KAAK,CAACC,GAAE,GAAI,YAAY;UACzCC,MAAM,EAAE;YACNC,aAAa,EAAE,IAAI,CAACJ,MAAM,CAACC,KAAK,CAACI,OAAM,GAAI,GAAE,GAAId;UACnD;QACF,CAAC,CAAC,CAACM,IAAI,CAAES,GAAG,IAAK;UACf,IAAIA,GAAG,CAACC,IAAI,CAACC,IAAG,IAAK,QAAQ,EAAE;YAC7B,IAAI,CAACR,MAAM,CAACS,QAAQ,CAAC,cAAc,CAAC;UACtC;QACF,CAAC,CAAC;MACJ,CAAC,EACAC,KAAK,CAAC,MAAM;QACXC,OAAO,CAACC,GAAG,CAAC,MAAM,CAAC;MACrB,CAAC,CAAC;IACN;EACF;AACF,CAAC"},"metadata":{},"sourceType":"module","externalDependencies":[]}