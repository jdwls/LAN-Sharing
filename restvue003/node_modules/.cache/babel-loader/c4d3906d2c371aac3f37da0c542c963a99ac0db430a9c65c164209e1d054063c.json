',\r\n                        data: formData,\r\n                        headers: {\r\n                            'Content-Type': 'multipart/form-data'\r\n                        }\r\n                    })\r\n                        .then((res) => {\r\n                            console.log(res);\r\n                        })\r\n                        .catch((err) => {\r\n                            console.log(err);\r\n                        })\r\n                }\r\n            }\r\n             seend_message_Files_fun(this.$store.state.currentChat,file.length)\r\n        }\r\n    }\r\n\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.icon {\r\n    cursor: pointer;\r\n}\r\n\r\n.icon:hover {\r\n    background-color: azure;\r\n}\r\n</style>"],"mappings":"AAkBA,OAAOA,KAAI,MAAO,OAAO;AAEzB,SAASC,uBAAsB,QAAS,kBAAkB;AAE1D,eAAe;EACXC,IAAI,EAAE,uBAAuB;EAC7BC,OAAO,EAAE;IACLC,oCAAoCA,CAAA,EAAG;MACnC,MAAMC,QAAO,GAAI,IAAI,CAACC,KAAK,CAACC,+BAA8B;MAC1DF,QAAQ,CAACG,KAAK,CAAC,CAAC;IACpB,CAAC;IACDC,4CAA4CA,CAAA,EAAG;MAC3C,MAAMJ,QAAO,GAAI,IAAI,CAACC,KAAK,CAACC,+BAA8B;MAC1D,MAAMG,IAAG,GAAIL,QAAQ,CAACM,KAAK;MAC3B,MAAMC,kBAAiB,GAAG;QAAC,oBAAoB,EAAC;UAC5C,MAAM,EAAE;YACJ,WAAW,EAAE,CAAC,CAAC,EAAE,CAAC,CAAC;YACnB,YAAY,EAAE,CAAC,IAAI,EAAE,IAAI;UAC7B,CAAC;UACD,YAAY,EAAE;YACV,iBAAiB,EAAC,IAAI;YACtB,kBAAkB,EAAC;UACnB;QACR;MACJ;MACIC,OAAO,CAACC,GAAG,CAAC,CAAC,CAAC;MACd,IAAIJ,IAAI,EAAE;QACN,KAAK,IAAIK,CAAA,GAAI,CAAC,EAAEA,CAAA,GAAIL,IAAI,CAACM,MAAM,EAAED,CAAC,EAAE,EAAE;UAClC,MAAME,QAAO,GAAI,IAAIC,QAAQ,CAAC;UAC9BL,OAAO,CAACC,GAAG,CAACJ,IAAI,CAACK,CAAC,CAAC,CAACb,IAAI,CAAC;UACzBe,QAAQ,CAACE,MAAM,CAAC,MAAM,EAAET,IAAI,CAACK,CAAC,CAAC,CAAC;UAChCE,QAAQ,CAACE,MAAM,CAAC,WAAW,EAAET,IAAI,CAACK,CAAC,CAAC,CAAC,EAAG;UACxCE,QAAQ,CAACE,MAAM,CAAC,WAAW,EAAET,IAAI,CAACK,CAAC,CAAC,CAACb,IAAI,CAAC;UAC1Ce,QAAQ,CAACE,MAAM,CAAC,WAAW,EAAET,IAAI,CAACK,CAAC,CAAC,CAACK,IAAI,CAAC;UAC1CH,QAAQ,CAACE,MAAM,CAAC,WAAW,EAAEE,YAAY,CAACC,OAAO,CAAC,UAAU,CAAC,CAAC;UAC9DL,QAAQ,CAACE,MAAM,CAAC,aAAa,EAAE,IAAI,CAACI,MAAM,CAACC,KAAK,CAA