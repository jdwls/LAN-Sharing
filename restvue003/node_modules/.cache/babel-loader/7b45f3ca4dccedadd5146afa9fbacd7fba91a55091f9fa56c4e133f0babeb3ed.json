{"ast":null,"code":"import UrseLIst from \"@/components/ChatRoom/UrseLIst/UrseLIst.vue\";\nexport default {\n  name: \"ChatRoomIndex\",\n  components: {\n    UrseLIst\n  },\n  data() {\n    return {\n      message: \"\",\n      currentChat: null\n    };\n  },\n  methods: {\n    startChat(user) {\n      this.currentChat = user;\n    },\n    sendMessage() {\n      if (this.message.trim()) {\n        console.log(`发送消息给 ${this.currentChat}: ${this.message}`);\n        this.message = '';\n      }\n    }\n  },\n  computed: {\n    userStatus() {\n      if (!this.currentChat) return {\n        type: 'info',\n        text: '未知'\n      };\n      const isOnline = this.$store.state.Online_Numbers.includes(this.currentChat);\n      return {\n        type: isOnline ? 'success' : 'info',\n        text: isOnline ? '在线' : '离线'\n      };\n    }\n  },\n  mounted() {\n    this.$store.dispatch(\"Tokers\");\n  }\n};","map":{"version":3,"names":["UrseLIst","name","components","data","message","currentChat","methods","startChat","user","sendMessage","trim","console","log","computed","userStatus","type","text","isOnline","$store","state","Online_Numbers","includes","mounted","dispatch"],"sources":["E:\\桌面\\code\\restvue003\\src\\components\\ChatRoom\\ChatRoomIndex.vue"],"sourcesContent":["<template>\r\n  <div class=\"chat-room-container\">\r\n    <div class=\"sidebar\">\r\n      <UrseLIst @user-selected=\"startChat\" />\r\n    </div>\r\n    <div class=\"main-content\">\r\n      <div class=\"chat-header\">\r\n        <el-row align=\"middle\" :gutter=\"20\">\r\n          <el-col :span=\"3\">\r\n            <el-avatar :size=\"60\" src=\"https://cube.elemecdn.com/0/88/03b0d39583f48206768a7534e55bcpng.png\" />\r\n          </el-col>\r\n          <el-col :span=\"21\">\r\n            <h2 style=\"margin:0 0 5px 0;font-weight:600;color:#303133\">与 {{ currentChat }} 的对话</h2>\r\n            <p style=\"margin:0;font-size:14px;color:#909399\">\r\n              <el-tag size=\"small\" :type=\"userStatus.type\">{{ userStatus.text }}</el-tag>\r\n            </p>\r\n          </el-col>\r\n        </el-row>\r\n        <el-divider style=\"margin:15px 0\" />\r\n      </div>\r\n      <div class=\"chat-bgcolor\">\r\n\r\n      </div>\r\n      <div class=\"message-input\">\r\n        <el-input placeholder=\"输入消息...\" v-model=\"message\" :disabled=\"!currentChat\">\r\n          <template #append>\r\n            <el-button :disabled=\"!currentChat\" @click=\"sendMessage()\">发送</el-button>\r\n          </template>\r\n        </el-input>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport UrseLIst from \"@/components/ChatRoom/UrseLIst/UrseLIst.vue\";\r\nexport default {\r\n  name: \"ChatRoomIndex\",\r\n  components: {\r\n    UrseLIst,\r\n  },\r\n  data() {\r\n    return {\r\n      message: \"\",\r\n      currentChat: null,\r\n    };\r\n  },\r\n  methods: {\r\n    startChat(user) {\r\n      this.currentChat = user;\r\n    },\r\n    sendMessage() {\r\n      if (this.message.trim()) {\r\n        console.log(`发送消息给 ${this.currentChat}: ${this.message}`);\r\n        this.message = '';\r\n      }\r\n    },\r\n  },\r\n  computed: {\r\n    userStatus() {\r\n      if (!this.currentChat) return { type: 'info', text: '未知' };\r\n      const isOnline = this.$store.state.Online_Numbers.includes(this.currentChat);\r\n      return {\r\n        type: isOnline ? 'success' : 'info',\r\n        text: isOnline ? '在线' : '离线'\r\n      };\r\n    },\r\n  },\r\n  mounted() {\r\n    this.$store.dispatch(\"Tokers\");\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.el-input {\r\n  height: 6vh;\r\n  background: #f0f8ff;\r\n}\r\n\r\n.chat-room-container {\r\n  display: flex;\r\n  height:100%;\r\n  background-color: #f5f7fa;\r\n}\r\n\r\n.sidebar {\r\n  width: 300px;\r\n  border-right: 1px solid #e2e5ec;\r\n  background: #f0f8ff;\r\n}\r\n\r\n.main-content {\r\n  flex: 1;\r\n  display: flex;\r\n  flex-direction: column;\r\n  margin-top: 2vh;\r\n}\r\n  /* .empty-state {\r\n    display: flex;\r\n    justify-content: center;\r\n    align-items: center;\r\n    height: 80vh;\r\n    margin: 20px;\r\n    background: #fff;\r\n    border-radius: 8px;\r\n    box-shadow: 0 2px 12px 0 rgba(0, 0, 0, 0.1);\r\n  } */\r\n\r\n.empty-state :deep(.el-empty) {\r\n  transform: scale(1.5);\r\n}\r\n\r\n.empty-state :deep(.el-empty__description p) {\r\n  font-size: 18px;\r\n  margin-top: 20px;\r\n}\r\n\r\n.chat-header {\r\n  padding: 15px 0;\r\n  background: #fff;\r\n  position: sticky;\r\n  top: 0;\r\n  z-index: 1;\r\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);\r\n  border-radius: 10px;\r\n}\r\n\r\n.message-input {\r\n width: 72.7vw;\r\n margin-top: 3vh;\r\n}\r\n\r\n.chat-bgcolor {\r\n  width: 72.7vw;\r\n  height: 67vh;\r\n  background-color: #ffffff;\r\n  overflow-y: hidden;\r\n  margin-top: 3vh;\r\n  border-radius: 10px;\r\n}\r\n</style>\r\n"],"mappings":"AAmCA,OAAOA,QAAO,MAAO,6CAA6C;AAClE,eAAe;EACbC,IAAI,EAAE,eAAe;EACrBC,UAAU,EAAE;IACVF;EACF,CAAC;EACDG,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,OAAO,EAAE,EAAE;MACXC,WAAW,EAAE;IACf,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACPC,SAASA,CAACC,IAAI,EAAE;MACd,IAAI,CAACH,WAAU,GAAIG,IAAI;IACzB,CAAC;IACDC,WAAWA,CAAA,EAAG;MACZ,IAAI,IAAI,CAACL,OAAO,CAACM,IAAI,CAAC,CAAC,EAAE;QACvBC,OAAO,CAACC,GAAG,CAAE,SAAQ,IAAI,CAACP,WAAY,KAAI,IAAI,CAACD,OAAQ,EAAC,CAAC;QACzD,IAAI,CAACA,OAAM,GAAI,EAAE;MACnB;IACF;EACF,CAAC;EACDS,QAAQ,EAAE;IACRC,UAAUA,CAAA,EAAG;MACX,IAAI,CAAC,IAAI,CAACT,WAAW,EAAE,OAAO;QAAEU,IAAI,EAAE,MAAM;QAAEC,IAAI,EAAE;MAAK,CAAC;MAC1D,MAAMC,QAAO,GAAI,IAAI,CAACC,MAAM,CAACC,KAAK,CAACC,cAAc,CAACC,QAAQ,CAAC,IAAI,CAAChB,WAAW,CAAC;MAC5E,OAAO;QACLU,IAAI,EAAEE,QAAO,GAAI,SAAQ,GAAI,MAAM;QACnCD,IAAI,EAAEC,QAAO,GAAI,IAAG,GAAI;MAC1B,CAAC;IACH;EACF,CAAC;EACDK,OAAOA,CAAA,EAAG;IACR,IAAI,CAACJ,MAAM,CAACK,QAAQ,CAAC,QAAQ,CAAC;EAChC;AACF,CAAC"},"metadata":{},"sourceType":"module","externalDependencies":[]}