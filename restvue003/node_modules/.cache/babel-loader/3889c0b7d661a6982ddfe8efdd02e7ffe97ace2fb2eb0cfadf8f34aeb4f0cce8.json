{"ast":null,"code":"import VueSocketIO from \"vue-socket.io\";\nexport default {\n  name: \"IsOlineNumber\",\n  mounted() {\n    const createSocketItem = new VueSocketIO({\n      debug: true,\n      options: {\n        autoConnect: false,\n        //默认关闭，创建后打开，组件内使用可直接打开，就不需要用io.open()\n        transports: ['websocket']\n      },\n      connection: '127.0.0.1:5000'\n    });\n    const {\n      io,\n      emitter\n    } = createSocketItem;\n    // io.query.ttt = 8888888888\n    this.createSocketIO = io;\n    this.createSocketEmitter = emitter;\n    io.open();\n    io.on('connecting', () => {\n      console.log('正在连接---888');\n    });\n  }\n};","map":{"version":3,"names":["VueSocketIO","name","mounted","createSocketItem","debug","options","autoConnect","transports","connection","io","emitter","createSocketIO","createSocketEmitter","open","on","console","log"],"sources":["E:\\桌面\\code\\restvue003\\src\\components\\ChatRoom\\UrseLIst\\IsOlineNumber.vue"],"sourcesContent":["<template>\r\n    <div>\r\n\r\n    </div>\r\n</template>\r\n\r\n<script>\r\nimport VueSocketIO from \"vue-socket.io\"\r\nexport default {\r\n    name: \"IsOlineNumber\",\r\n    mounted() {\r\n        const createSocketItem = new VueSocketIO({\r\n            debug: true,\r\n            options: {\r\n                autoConnect: false,//默认关闭，创建后打开，组件内使用可直接打开，就不需要用io.open()\r\n                transports: ['websocket'],\r\n            },\r\n            connection: '127.0.0.1:5000'\r\n        })\r\n        const { io, emitter } = createSocketItem\r\n        // io.query.ttt = 8888888888\r\n        this.createSocketIO = io\r\n        this.createSocketEmitter = emitter\r\n        io.open()\r\n        io.on('connecting', () => { console.log('正在连接---888') })\r\n    }\r\n    }\r\n</script>"],"mappings":"AAOA,OAAOA,WAAU,MAAO,eAAc;AACtC,eAAe;EACXC,IAAI,EAAE,eAAe;EACrBC,OAAOA,CAAA,EAAG;IACN,MAAMC,gBAAe,GAAI,IAAIH,WAAW,CAAC;MACrCI,KAAK,EAAE,IAAI;MACXC,OAAO,EAAE;QACLC,WAAW,EAAE,KAAK;QAAC;QACnBC,UAAU,EAAE,CAAC,WAAW;MA