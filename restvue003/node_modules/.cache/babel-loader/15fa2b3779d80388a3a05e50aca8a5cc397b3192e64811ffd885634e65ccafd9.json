Iput.files;\r\n        const formData= new FormData()\r\n        console.log(file);\r\n        if(file){\r\n            for(let i=0;i<file.length;i++){\r\n                 formData.append('file', file[i]);\r\n                 axios({\r\n                    url:this.$store.state.api+'/Chat_Room_File_Updata_api',\r\n                    method:'post',\r\n                    data:{\r\n                        'FileInput':formData,\r\n                        'file_name':file[i].name,\r\n                        'file_type':file[i].type,\r\n                        'send_name':localStorage.getItem('UresName'),\r\n                        'report_name':this.$store.state.currentChat,         },\r\n                    headers: {\r\n                        'Content-Type': 'multipart/form-data'\r\n                    }\r\n                 })\r\n                 .then((res)=>{\r\n                    console.log(res);\r\n                 })\r\n                 .catch((err)=>{\r\n                    console.log(err);\r\n                 })\r\n            }\r\n            \r\n        }\r\n        else{\r\n            console.log(\"没有选择文件\");\r\n        }\r\n        // if(file){\r\n        //     const formData = new FormData();\r\n        //     formData.append('file', file);\r\n        //     // 这里可以添加上传文件的逻辑，比如使用axios发送POST请求\r\n        //     this.$emit('file-uploaded', formData); // 向父组件发送事件，传递文件数据\r\n        // } else {\r\n        //     console.error(\"没有选择文件\");\r\n        // }\r\n    }\r\n}\r\n\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.icon{\r\n    cursor: pointer;\r\n}\r\n.icon:hover{\r\n    background-color: azure;\r\n}\r\n</style>"],"mappings":"AAkBA,OAAOA,KAAI,MAAO,OAAO;;AAEzB;;AAEA,eAAe;EACXC,IAAI,EAAE,uBAAuB;EACjCC,OAAO,EAAC;IACJC,oCAAoCA,CAAA,EAAE;MAClC,MAAMC,QAAQ,GAAC,IAAI,CAACC,KAAK,CAACC,+BAA8B;MACxDF,QAAQ,CAACG,KAAK,CAAC,CAAC;IACpB,CAAC;IACDC,4CAA4CA,CAAA,EAAE;MAC1C,MAAMJ,QAAQ,GAAC,IAAI,CAACC,KAAK,CAACC,+BAA8B;MACxD,MAAMG,IAAI,GAACL,QAAQ,CAACM,KAAK;MACzB,MAAMC,QAA