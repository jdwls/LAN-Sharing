{"ast":null,"code":"import axios from 'axios';\n\n// import { seend_message_Files_fun } from \"@/socke/index.js\";\n\nexport default {\n  name: 'Chat_Room_File_Updata',\n  methods: {\n    Chat_Room_File_Updata_uploadFile_fun() {\n      const fileIput = this.$refs.Chat_Room_File_Updata_input_ref;\n      fileIput.click();\n    },\n    Chat_Room_File_Updata_input_handleFileUpload() {\n      const fileIput = this.$refs.Chat_Room_File_Updata_input_ref;\n      const file = fileIput.files;\n      const formData = new FormData();\n      console.log(file);\n      if (file) {\n        for (let i = 0; i < file.length; i++) {\n          formData.append('file', file[i]);\n          axios({\n            url: this.$store.state.api + '/Chat_Room_File_Updata_api',\n            method: 'post',\n            data: {\n              'FileInput': formData,\n              'file_name': file[i].name,\n              'file_type': file[i].type,\n              'send_name': localStorage.getItem('UresName'),\n              'report_name': this.$store.state.currentChat\n            },\n            headers: {\n              'Content-Type': 'multipart/form-data'\n            }\n          }).then(res => {\n            console.log(res);\n          }).catch(err => {\n            console.log(err);\n          });\n        }\n      } else {\n        console.log(\"没有选择文件\");\n      }\n      // if(file){\n      //     const formData = new FormData();\n      //     formData.append('file', file);\n      //     // 这里可以添加上传文件的逻辑，比如使用axios发送POST请求\n      //     this.$emit('file-uploaded', formData); // 向父组件发送事件，传递文件数据\n      // } else {\n      //     console.error(\"没有选择文件\");\n      // }\n    }\n  }\n};","map":{"version":3,"names":["axios","name","methods","Chat_Room_File_Updata_uploadFile_fun","fileIput","$refs","Chat_Room_File_Updata_input_ref","click","Chat_Room_File_Updata_input_handleFileUpload","file","files","formData","FormData","console","log","i","length","append","url","$store","state","api","method","