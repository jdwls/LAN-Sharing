{"ast":null,"code":"import axios from \"axios\";\nimport { ElMessageBox } from \"element-plus\";\nexport default {\n  name: \"NewText\",\n  data() {\n    return {\n      TextName: \"\",\n      TextConter: \"\"\n    };\n  },\n  methods: {\n    async onSubmit() {\n      if (this.TextName != \"\") {\n        ElMessageBox.alert(\"是否创建\" + this.TextName + \"的文本文件\", \"是否确认创建文本文件\", {\n          showConfirmButton: true,\n          showCancelButton: true,\n          confirmButtonText: \"确认\",\n          cancelButtonText: \"取消\"\n        }).catch(() => {\n          console.log(\"成功取消\");\n        }).then(async () => {\n          axios({\n            method: \"get\",\n            url: this.$store.state.api + \"/TextLnsert\",\n            params: {\n              TextName: this.TextName,\n              TextConter: this.TextConter,\n              NowPath: this.$store.state.DirPath\n            }\n          }).then(res => {\n            if (res.data.message == \"创建文本文件成功\") {\n              this.$store.dispatch(\"DirsFileList\");\n              ElMessageBox.alert(res.data.message, \"创建文本状态\", {\n                showConfirmButton: true,\n                showCancelButton: true,\n                confirmButtonText: \"再来一个\",\n                cancelButtonText: \"取消\"\n              }).catch(() => {\n                this.$store.state.dialogVisible = false;\n              });\n            } else if (res.data.message == \"当前存在相关文件\") {\n              ElMessageBox.alert(res.data.message, \"创建文本状态\", {\n                showConfirmButton: true,\n                showCancelButton: true,\n                confirmButtonText: \"再来一个\",\n                cancelButtonText: \"取消\"\n              }).catch(() => {\n                this.$store.state.dialogVisible = false;\n              }).then(() => {\n                this.TextName = \"\";\n                this.TextConter = \"\";\n              });\n            } else if (res.data.message == \"创建文本文件失败\") {\n              ElMessageBox.alert(res.data.