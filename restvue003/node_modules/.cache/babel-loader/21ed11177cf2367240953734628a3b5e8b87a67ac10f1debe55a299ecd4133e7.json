{"ast":null,"code":"import axios from 'axios';\nimport { seend_message_Files_fun } from \"@/socke/index.js\";\nexport default {\n  name: 'Chat_Room_File_Updata',\n  methods: {\n    Chat_Room_File_Updata_uploadFile_fun() {\n      const fileIput = this.$refs.Chat_Room_File_Updata_input_ref;\n      fileIput.click();\n    },\n    Chat_Room_File_Updata_input_handleFileUpload() {\n      const fileIput = this.$refs.Chat_Room_File_Updata_input_ref;\n      const file = fileIput.files;\n      const formData = new FormData();\n      console.log(file);\n      if (file) {\n        for (let i = 0; i < file.length; i++) {\n          formData.append('file', file[i]);\n          formData.append('FileInput', file[i]); // 字段名与后端一致\n          formData.append('file_name', file[i].name);\n          formData.append('file_type', file[i].type);\n          formData.append('send_name', localStorage.getItem('UresName'));\n          formData.append('report_name', this.$store.state.currentChat);\n          axios({\n            url: this.$store.state.api + '/Chat_Room_File_Updata_api',\n            method: 'post',\n            data: formData,\n            headers: {\n              'Content-Type': 'multipart/form-data'\n            }\n          }).then(res => {\n            if (res.data.ms == '文件上传成功') {\n              seend_message_Files_fun(file[i].name, this.$store.state.currentChat, this.$store.state.messages_lists.length, file[i].type);\n            }\n          }).catch(err => {\n            console.log(err);\n          });\n        }\n      } else {\n        console.log(\"没有选择文件\");\n      }\n      // if(file){\n      //     const formData = new FormData();\n      //     formData.append('file', file);\n      //     // 这里可以添加上传文件的逻辑，比如使用axios发送POST请求\n      //     this.$emit('file-uploaded', formData); // 向父组件发送事件，传递文件数据\n      // } else {\n      //     console.error(\"没有选择文件\");\n      // }\n    }\n  }\n};","map":{"version":3,"names":["axios","seend_message_Files_fun","name","methods","Chat_Room_File_Updata_uploadFile_fun","fileIput","$refs","Chat_Room_File_Updata_input_ref","click","Chat_Room_File_Updata_input_handleFileUpload","file","files","formData","FormData","console","log","i","length","append","type","localStorage","getItem","$store","state","currentChat","url","api","method","data","headers","then","res","ms","messages_lists","catch","err"],"sources":["C:\\Users\\administered\\Desktop\\code\\restvue003\\src\\components\\ChatRoom\\Chat_Room_infomation\\Chat_Room_File_Updata.vue"],"sourcesContent":["<template>\r\n    <div>\r\n        <div class=\"chat-room-file-updata\">\r\n            <svg t=\"1754017969599\" class=\"icon\" viewBox=\"0 0 1024 1024\" version=\"1.1\" p-id=\"1548\" width=\"40\" height=\"40\"\r\n                @click=\"Chat_Room_File_Updata_uploadFile_fun()\">\r\n                <path\r\n                    d=\"M371.2 455.111111L483.555556 343.893333v262.826667a28.444444 28.444444 0 1 0 56.888888 0v-262.826667L652.8 455.111111a28.444444 28.444444 0 0 0 40.106667-40.106667L532.195556 256a28.444444 28.444444 0 0 0-40.106667 0l-160.995556 160.995556A28.444444 28.444444 0 0 0 371.2 455.111111zM739.555556 663.608889a28.444444 28.444444 0 0 0-28.444445 28.444444v28.444445H312.888889v-28.444445a28.444444 28.444444 0 0 0-56.888889 0v56.888889a28.444444 28.444444 0 0 0 28.444444 28.444445h455.111112a28.444444 28.444444 0 0 0 28.444444-28.444445v-56.888889a28.444444 28.444444 0 0 0-28.444444-28.444444z\"\r\n                    p-id=\"1549\"></path>\r\n            </svg>\r\n            <input type=\"file\" @change=\"Chat_Room_File_Updata_input_handleFileUpload()\" v-show=\"false\"\r\n                ref=\"Chat_Room_File_Updata_input_ref\" multiple \r\n                accept=\".jpg,.jpeg,.png,.gif,.bmp,.webp,.svg,.mp4,.webm,.ogg,.apng,.avif,.bmp,.quicktime,.x-matroska,.mpeg\"\r\n                />\r\n        </div>\r\n    </div>\r\n\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\n\r\nimport { seend_message_Files_fun } from \"@/socke/index.js\";\r\n\r\nexport default {\r\n    name: 'Chat_Room_File_Updata',\r\n    methods: {\r\n        Chat_Room_File_Updata_uploadFile_fun() {\r\n            const fileIput = this.$refs.Chat_Room_File_Updata_input_ref\r\n            fileIput.click();\r\n        },\r\n        Chat_Room_File_Updata_input_handleFileUpload() {\r\n            const fileIput = this.$refs.Chat_Room_File_Updata_input_ref\r\n            const file = fileIput.files;\r\n            const formData = new FormData()\r\n            console.log(file);\r\n            if (file) {\r\n                for (let i = 0; i < file.length; i++) {\r\n                    formData.append('file', file[i]);\r\n                    formData.append('FileInput', file[i]);  // 字段名与后端一致\r\n                    formData.append('file_name', file[i].name);\r\n                    formData.append('file_type', file[i].type);\r\n                    formData.append('send_name', localStorage.getItem('UresName'));\r\n                    formData.append('report_name', this.$store.state.currentChat);\r\n                    axios({\r\n                        url: this.$store.state.api + '/Chat_Room_File_Updata_api',\r\n                        method: 'post',\r\n                        data: formData,\r\n                        headers: {\r\n                            'Content-Type': 'multipart/form-data'\r\n                        }\r\n                    })\r\n                        .then((res) => {\r\n                            if(res.data.ms=='文件上传成功'){\r\n                                seend_message_Files_fun(file[i].name,this.$store.state.currentChat,this.$store.state.messages_lists.length,file[i].type)\r\n                            }\r\n                        })\r\n                        .catch((err) => {\r\n                            console.log(err);\r\n                        })\r\n                }\r\n\r\n            }\r\n            else {\r\n                console.log(\"没有选择文件\");\r\n            }\r\n            // if(file){\r\n            //     const formData = new FormData();\r\n            //     formData.append('file', file);\r\n            //     // 这里可以添加上传文件的逻辑，比如使用axios发送POST请求\r\n            //     this.$emit('file-uploaded', formData); // 向父组件发送事件，传递文件数据\r\n            // } else {\r\n            //     console.error(\"没有选择文件\");\r\n            // }\r\n        }\r\n    }\r\n\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.icon {\r\n    cursor: pointer;\r\n}\r\n\r\n.icon:hover {\r\n    background-color: azure;\r\n}\r\n</style>"],"mappings":"AAmBA,OAAOA,KAAI,MAAO,OAAO;AAEzB,SAASC,uBAAsB,QAAS,kBAAkB;AAE1D,eAAe;EACXC,IAAI,EAAE,uBAAuB;EAC7BC,OAAO,EAAE;IACLC,oCAAoCA,CAAA,EAAG;MACnC,MAAMC,QAAO,GAAI,IAAI,CAACC,KAAK,CAACC,+BAA8B;MAC1DF,QAAQ,CAACG,KAAK,CAAC,CAAC;IACpB,CAAC;IACDC,4CAA4CA,CAAA,EAAG;MAC3C,MAAMJ,QAAO,GAAI,IAAI,CAACC,KAAK,CAACC,+BAA8B;MAC1D,MAAMG,IAAG,GAAIL,QAAQ,CAACM,KAAK;MAC3B,MAAMC,QAAO,GAAI,IAAIC,QAAQ,CAAC;MAC9BC,OAAO,CAACC,GAAG,CAACL,IAAI,CAAC;MACjB,IAAIA,IAAI,EAAE;QACN,KAAK,IAAIM,CAAA,GAAI,CAAC,EAAEA,CAAA,GAAIN,IAAI,CAACO,MAAM,EAAED,CAAC,EAAE,EAAE;UAClCJ,QAAQ,CAACM,MAAM,CAAC,MAAM,EAAER,IAAI,CAACM,CAAC,CAAC,CAAC;UAChCJ,QAAQ,CAACM,MAAM,CAAC,WAAW,EAAER,IAAI,CAACM,CAAC,CAAC,CAAC,EAAG;UACxCJ,QAAQ,CAACM,MAAM,CAAC,WAAW,EAAER,IAAI,CAACM,CAAC,CAAC,CAACd,IAAI,CAAC;UAC1CU,QAAQ,CAACM,MAAM,CAAC,WAAW,EAAER,IAAI,CAACM,CAAC,CAAC,CAACG,IAAI,CAAC;UAC1CP,QAAQ,CAACM,MAAM,CAAC,WAAW,EAAEE,YAAY,CAACC,OAAO,CAAC,UAAU,CAAC,CAAC;UAC9DT,QAAQ,CAACM,MAAM,CAAC,aAAa,EAAE,IAAI,CAACI,MAAM,CAACC,KAAK,CAACC,WAAW,CAAC;UAC7DxB,KAAK,CAAC;YACFyB,GAAG,EAAE,IAAI,CAACH,MAAM,CAACC,KAAK,CAACG,GAAE,GAAI,4BAA4B;YACzDC,MAAM,EAAE,MAAM;YACdC,IAAI,EAAEhB,QAAQ;YACdiB,OAAO,EAAE;cACL,cAAc,EAAE;YACpB;UACJ,CAAC,EACIC,IAAI,CAAEC,GAAG,IAAK;YACX,IAAGA,GAAG,CAACH,IAAI,CAACI,EAAE,IAAE,QAAQ,EAAC;cACrB/B,uBAAuB,CAACS,IAAI,CAACM,CAAC,CAAC,CAACd,IAAI,EAAC,IAAI,CAACoB,MAAM,CAACC,KAAK,CAACC,WAAW,EAAC,IAAI,CAACF,MAAM,CAACC,KAAK,CAACU,cAAc,CAAChB,MAAM,EAACP,IAAI,CAACM,CAAC,CAAC,CAACG,IAAI;YAC3H;UACJ,CAAC,EACAe,KAAK,CA