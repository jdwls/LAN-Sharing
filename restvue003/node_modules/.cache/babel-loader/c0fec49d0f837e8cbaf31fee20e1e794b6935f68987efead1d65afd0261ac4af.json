{"ast":null,"code":"import { sendMessage } from \"@/socke/index.js\";\nexport default {\n  name: 'Chat_Room_infomation_view',\n  props: {\n    currentChat: {\n      type: String,\n      // 根据实际类型调整\n      default: null\n    }\n  },\n  data() {\n    return {\n      message: \"\"\n    };\n  },\n  computed: {\n    userStatus() {\n      if (!this.currentChat) return {\n        type: 'info',\n        text: '未知'\n      };\n      const isOnline = this.$store.state.Online_Numbers.includes(this.currentChat);\n      return {\n        type: isOnline ? 'success' : 'info',\n        text: isOnline ? '在线' : '离线'\n      };\n    }\n  },\n  methods: {\n    sendMessage() {\n      if (this.message.trim() && this.currentChat) {\n        sendMessage(this.message, this.currentChat);\n        this.message = \"\";\n      }\n    }\n  }\n};","map":{"version":3,"names":["sendMessage","name","props","currentChat","type","String","default","data","message","computed","userStatus","text","isOnline","$store","state","Online_Numbers","includes","methods","trim"],"sources":["C:\\Users\\administered\\Desktop\\code\\restvue003\\src\\components\\ChatRoom\\Chat_Room_infomation\\Chat_Room_infomation_view.vue"],"sourcesContent":["<template>\r\n    <div>\r\n        <div class=\"chat-header\">\r\n            <el-row align=\"middle\" :gutter=\"20\">\r\n                <el-col :span=\"3\">\r\n                    <el-avatar :size=\"60\" src=\"https://cube.elemecdn.com/0/88/03b0d39583f48206768a7534e55bcpng.png\" />\r\n                </el-col>\r\n                <el-col :span=\"21\">\r\n                    <h2 style=\"margin:0 0 5px 0;font-weight:600;color:#303133\">与 {{ currentChat }} 的对话</h2>\r\n                    <p style=\"margin:0;font-size:14px;color:#909399\">\r\n                        <el-tag size=\"small\" :type=\"userStatus.type\">{{ userStatus.text }}</el-tag>\r\n                    </p>\r\n                </el-col>\r\n            </el-row>\r\n            <el-divider style=\"margin:15px 0\" />\r\n        </div>\r\n        <div class=\"chat-bgcolor\">\r\n           <P>1</P>\r\n        </div>\r\n        <div class=\"message-input\">\r\n            <el-input \r\n                placeholder=\"输入消息...\" \r\n                v-model=\"message\" \r\n                :disabled=\"!currentChat\"\r\n                @keyup.enter=\"sendMessage\"\r\n            >\r\n                <template #append>\r\n                    <el-button :disabled=\"!currentChat\" @click=\"sendMessage\">发送</el-button>\r\n                </template>\r\n            </el-input>\r\n        </div>\r\n    </div>\r\n</template>\r\n\r\n<script>\r\nimport { sendMessage } from \"@/socke/index.js\";\r\n\r\nexport default {\r\n    name: 'Chat_Room_infomation_view',\r\n    props: {\r\n        currentChat: {\r\n            type: String, // 根据实际类型调整\r\n            default: null\r\n        }\r\n    },\r\n    data() {\r\n        return {\r\n            message: \"\",\r\n        }\r\n    },\r\n    computed: {\r\n        userStatus() {\r\n            if (!this.currentChat) return { type: 'info', text: '未知' };\r\n            const isOnline = this.$store.state.Online_Numbers.includes(this.currentChat);\r\n            return {\r\n                type: isOnline ? 'success' : 'info',\r\n                text: isOnline ? '在线' : '离线'\r\n            };\r\n        },\r\n    },\r\n    methods: {\r\n        sendMessage() {\r\n            if (this.message.trim() && this.currentChat) {\r\n                sendMessage(this.message, this.currentChat);\r\n                this.message = \"\";\r\n            }\r\n        },\r\n    }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n/* 保持原有样式不变 */\r\n.el-input {\r\n  height: 6vh;\r\n  background: #f0f8ff;\r\n}\r\n\r\n.chat-room-container {\r\n  display: flex;\r\n  background-color: #f5f7fa;\r\n}\r\n\r\n.sidebar {\r\n  width: 300px;\r\n  border-right: 1px solid #e2e5ec;\r\n  background: #f0f8ff;\r\n}\r\n\r\n.main-content {\r\n  flex: 1;\r\n  display: flex;\r\n  flex-direction: column;\r\n  margin-top: 2vh;\r\n}\r\n\r\n.chat-header {\r\n  padding: 15px 0;\r\n  background: #fff;\r\n  position: sticky;\r\n  top: 0;\r\n  z-index: 1;\r\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);\r\n  border-radius: 10px;\r\n}\r\n\r\n.message-input {\r\n  width: 70vw;\r\n  margin-top: 3vh;\r\n}\r\n\r\n.chat-bgcolor {\r\n  width: 70vw;\r\n  height: 67vh;\r\n  background-color: #ffffff;\r\n  overflow-y: auto; /* 建议改为auto以便滚动 */\r\n  margin-top: 3vh;\r\n  border-radius: 10px;\r\n  padding: 15px;\r\n  box-sizing: border-box;\r\n}\r\n</style>"],"mappings":"AAmCA,SAASA,WAAU,QAAS,kBAAkB;AAE9C,eAAe;EACXC,IAAI,EAAE,2BAA2B;EACjCC,KAAK,EAAE;IACHC,WAAW,EAAE;MACTC,IAAI,EAAEC,MAAM;MAAE;MACdC,OAAO,EAAE;IACb;EACJ,CAAC;EACDC,IAAIA,CAAA,EAAG;IACH,OAAO;MACHC,OAAO,EAAE;IACb;EACJ,CAAC;EACDC,QAAQ,EAAE;IACNC,UAAUA,CAAA,EAAG;MACT,IAAI,CAAC,IAAI,CAACP,WAAW,EAAE,OAAO;QAAEC,IAAI,EAAE,MAAM;QAAEO,IAAI,EAAE;MAAK,CAAC;MAC1D,MAAMC,QAAO,GAAI,IAAI,CAACC,MAAM,CAACC,KAAK,CAACC,cAAc,CAACC,QAAQ,CAAC,IAAI,CAACb,WAAW,CAAC;MAC5E,OAAO;QACHC,IAAI,EAAEQ,QAAO,GAAI,SAAQ,GAAI,MAAM;QACnCD,IAAI,EAAEC,QAAO,GAAI,IAAG,GAAI;MAC5B,CAAC;IACL;EACJ,CAAC;EACDK,OAAO,EAAE;IACLjB,WAAWA,CAAA,EAAG;MACV,IAAI,IAAI,CAACQ,OAAO,CAACU,IAAI,CAAC,KAAK,IAAI,CAACf,WAAW,EAAE;QACzCH,WAAW,CAAC,IAAI,CAACQ,OAAO,EAAE,IAAI,CAACL,WAAW,CAAC;QAC3C,IAAI,CAACK,OAAM,GAAI,EAAE;MACrB;IACJ;EACJ;AACJ"},"metadata":{},"sourceType":"module","externalDependencies":[]}