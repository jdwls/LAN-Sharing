ame_arr);\r\n                    }\r\n                    else{\r\n                    formData.append('FileS_name_arr',false )\r\n                    formData.append('FileS_Types',false)\r\n                    }\r\n                    axios({\r\n                        url: this.$store.state.api + '/Chat_Room_File_Updata_api',\r\n                        method: 'post',\r\n                        data: formData,\r\n                        headers: {\r\n                            'Content-Type': 'multipart/form-data',\r\n                        }\r\n                    })\r\n                        .then((res) => {\r\n                            console.log(res);\r\n                        })\r\n                        .catch((err) => {\r\n                            console.log(err);\r\n                        })\r\n                }\r\n                setTimeout(async () => {\r\n                      seend_message_Files_fun(this.$store.state.currentChat);   \r\n                }, 1000)\r\n                .then(()=>{})\r\n                console.log(1);\r\n                \r\n            }\r\n             \r\n    }\r\n    }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.icon {\r\n    cursor: pointer;\r\n}\r\n\r\n.icon:hover {\r\n    background-color: azure;\r\n}\r\n</style>"],"mappings":";AAkBA,OAAOA,KAAI,MAAO,OAAO;AAEzB,SAASC,uBAAsB,QAAS,kBAAkB;AAE1D,eAAe;EACXC,IAAI,EAAE,uBAAuB;EAC7BC,OAAO,EAAE;IACLC,oCAAoCA,CAAA,EAAG;MACnC,MAAMC,QAAO,GAAI,IAAI,CAACC,KAAK,CAACC,+BAA8B;MAC1DF,QAAQ,CAACG,KAAK,CAAC,CAAC;IACpB,CAAC;IACDC,4CAA4CA,CAAA,EAAG;MAC3C,IAAIC,cAAc,GAAC,EAAC;MACpB,IAAIC,WAAW,GAAC,EAAC;MACjB,MAAMN,QAAO,GAAI,IAAI,CAACC,KAAK,CAACC,+BAA8B;MAC1D,MAAMK,IAAG,GAAIP,QAAQ,CAACQ,KAAK;MAC3B,IAAID,IAAI,EAAE;QACN,KAAK,IAAIE,CAAA,GAAI,CAAC,EAAEA,CAAA,GAAIF,IAAI,CAACG,MAAM,EAAED,CAAC,EAAE,EAAE;UAClC,MAAME,QAAO,GAAI,IAAIC,QAAQ,CAAC;UAC9BC,OAAO,CAACC,GAAG,CAACP,IAAI,CAACE,CAAC,CAAC,CAACZ,IAAI,CAAC;UACzBc,QAAQ,CAACI,MAAM,CAAC,MAAM,EAAER,IAAI,CAACE,CAAC,CAAC,CAAC,EAAE;UAClCE,QAAQ,CAA