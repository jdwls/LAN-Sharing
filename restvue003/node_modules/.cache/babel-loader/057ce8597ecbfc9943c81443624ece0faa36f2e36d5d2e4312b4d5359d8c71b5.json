  :show-file-list=\"false\" \r\n                    :on-success=\"handleAvatarSuccess\"\r\n                    :before-upload=\"beforeAvatarUpload\">\r\n                    <img v-if=\"imageUrl\" :src=\"imageUrl\" class=\"avatar\">\r\n                    <i v-else class=\"el-icon-plus avatar-uploader-icon\"></i>\r\n                </el-upload>\r\n\r\n            </el-form-item>\r\n            <el-form-item label=\"修改密码:\">\r\n                <el-input v-model=\"stteing.ChangePassword\"></el-input>\r\n            </el-form-item>\r\n            <el-form-item label=\"第二次密码\">\r\n                <el-input v-model=\"stteing.TwoChangePassword\"></el-input>\r\n            </el-form-item>\r\n            <div class=\"Authority\">\r\n                <el-form-item label=\"权限选择：\">\r\n                    <el-select v-model=\"stteing.Authority\" placeholder=\"请选择权限\" class=\"AuthorityS\">\r\n                        <el-option label=\"用户\" value=\"Ures\"></el-option>\r\n                        <el-option label=\"管理员\" value=\"Admin\"></el-option>\r\n                    </el-select>\r\n                </el-form-item>\r\n                <el-form-item label=\"选择用户：\">\r\n                    <el-select v-model=\"stteing.AdminAndUresName\" placeholder=\"请选择对应用户的权限\" class=\"AuthorityS\">\r\n                        <el-option :label=item :value=item v-for=\"(item, index) in stteingData.AdminAndUres\"\r\n                            :key=index></el-option>\r\n                    </el-select>\r\n                </el-form-item>\r\n            </div>\r\n            <el-form-item label=\"文件上传的线程:\">\r\n                <el-select v-model=\"stteing.UpadaFileNumbers\" placeholder=\"请选择权限\">\r\n                    <el-option :label=\"item\" :value=\"item\" v-for=\"(item, index) in stteingData.UpadaFileNumbers\"\r\n                        :key=\"index\"></el-option>\r\n                </el-select>\r\n            </el-form-item>\r\n            <el-form-item>\r\n                <el-button type=\"primary\" @click=\"onSubmit\">立即创建</el-button>\r\n                <el-button>取消</el-button>\r\n            </el-form-item>\r\n        </el-form>\r\n    </div>\r\n</template>\r\n<script>\r\nexport default {\r\n    name: \"steeingView\",\r\n    data() {\r\n        return {\r\n            stteing: {\r\n                ChangePassword: \"\",\r\n                TwoChangePassword: \"\",\r\n                Authority: '',\r\n                AdminAndUresName: '',\r\n                UpadaFileNumbers: ''\r\n            },\r\n            stteingData: {\r\n                AdminAndUres: ['A', 'B', 'C'],\r\n                UpadaFileNumbers: [1, 2, 3, 4, 5]\r\n            },\r\n            imageUrl:''\r\n\r\n        }\r\n    },\r\n    methods: {\r\n        onSubmit() {\r\n            console.log(this.stteing.AdminAndUresName);\r\n        },\r\n        handleAvatarSuccess(res, file) {\r\n        this.imageUrl = URL.createObjectURL(file.raw);\r\n      },\r\n        beforeAvatarUpload(file) {\r\n        const isJPG = file.type === 'image/jpeg';\r\n        const isLt2M = file.size / 1024 / 1024 < 2;\r\n\r\n        if (!isJPG) {\r\n          this.$message.error('上传头像图片只能是 JPG 格式!');\r\n        }\r\n        if (!isLt2M) {\r\n          this.$message.error('上传头像图片大小不能超过 2MB!');\r\n        }\r\n        return isJPG && isLt2M;\r\n      },\r\n      IconUpload(){\r\n        console.log(this.$refs.IconUpload.file);\r\n        \r\n      }\r\n    }\r\n}\r\n</script>\r\n<style scoped>\r\n.el-form {\r\n    width: 30vw;\r\n}\r\n\r\n.forms {\r\n    margin: 0 auto;\r\n}\r\n\r\n.Authority {\r\n    display: flex;\r\n    justify-content: space-between\r\n}\r\n\r\n.AuthorityS {\r\n    width: 9vw;\r\n}\r\n</style>\r\n<style>\r\n  .avatar-uploader .el-upload {\r\n    border: 1px dashed #d9d9d9;\r\n    border-radius: 6px;\r\n    cursor: pointer;\r\n    position: relative;\r\n    overflow: hidden;\r\n  }\r\n  .avatar-uploader .el-upload:hover {\r\n    border-color: #409EFF;\r\n  }\r\n  .avatar-uploader-icon {\r\n    font-size: 28px;\r\n    color: #8c939d;\r\n    width: 178px;\r\n    height: 178px;\r\n    line-height: 178px;\r\n    text-align: center;\r\n  }\r\n  .avatar {\r\n    width: 178px;\r\n    height: 178px;\r\n    display: block;\r\n  }\r\n</style>"],"mappings":";;;AAiDA,eAAe;EACXA,IAAI,EAAE,aAAa;EACnBC,IAAIA,CAAA,EAAG;IACH,OAAO;MACHC,OAAO,EAAE;QACLC,cAAc,EAAE,EAAE;QAClBC,iBAAiB,EAAE,EAAE;QACrBC,SAAS,EAAE,EAAE;QACbC,gBAAgB,EAAE,EAAE;QACpBC,gBAAgB,EAAE;MACtB,CAAC;MACDC,WAAW,EAAE;QACTC,YAAY,EAAE,CAAC,GAAG,EAAE,GAAG,EAAE,GAAG,CAAC;QAC7BF,gBAAgB,EAAE,CAAC,CAAC,EAAE,CAAC,EAAE,CAAC,EAAE,CAAC,EAAE,CAAC;MACpC,CAAC;MACDG,QAAQ,EAAC;IAEb;EACJ,CAAC;EACDC,OAAO,EAAE;IACLC,QAAQA,CAAA,EAAG;MACPC,OAAO,CAACC,GAAG,CAAC,IAAI,CAACZ,OAAO,CAACI,gBAAgB,CAAC;IAC9C,CAAC;IACDS,mBAAmBA,CAACC,GAAG,EAAEC,IAAI,EAAE;MAC/B,IAAI,CAACP,QAAO,GAAIQ,GAAG,CAACC,eAAe,CAACF,IAAI,CAACG,GAAG,CAAC;IAC/C,CAAC;IACCC,kBAAkBA,CAACJ,IAAI,EAAE;MACzB,MAAMK,KAAI,GAAIL,IAAI,CAACM,IAAG,KAAM,YAAY;MACxC,MAAMC,MAAK,GAAIP,IAAI,CAACQ,IAAG,GAAI,IAAG,GAAI,IAAG,GAAI,CAAC;MAE1C,IAAI,CAACH,KAAK,EAAE;QACV,IAAI,CAACI,QAAQ,CAACC,KAAK,CAAC,mBAAmB,CAAC;MAC1C;MACA,IAAI,CAACH,MAAM,EAAE;QACX,IAAI,CAACE,QAAQ,CAACC,KAAK,CAAC,mBAAmB,CAAC;MAC1C;MACA,OAAOL,KAAI,IAAKE,MAAM;IACxB,CAAC;IACDI,UAAUA,CAAA,EAAE;MACVf,OAAO,CAACC,GAAG,CAAC,IAAI,CAACe,KAAK,CAACD,UAAU,CAACX,IAAI,CAAC;IAEzC;EACF;AACJ"},"metadata":{},"sourceType":"module","externalDependencies":[]}