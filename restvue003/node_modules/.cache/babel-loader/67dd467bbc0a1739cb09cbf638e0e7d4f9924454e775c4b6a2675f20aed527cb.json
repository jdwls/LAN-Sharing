{"ast":null,"code":"export default {\n  name: \"progressEl\",\n  data() {\n    return {\n      size: \"\"\n    };\n  },\n  computed: {\n    UpdataTotal() {\n      if (this.$store.state.upadaFileNumberSum == this.$store.state.files.length) {\n        this.$store.dispatch(\"DirsFileList\");\n        return \"当前文件上传总数为：\" + this.$store.state.upadaFileNumberSum + \"个文件,已经上传\" + this.$store.state.files.length + \"个文件\";\n      } else {\n        console.log(this.$store.state.files.length, this.$store.state.upadaFileNumberSum);\n        return \"当前文件上传总数为：\" + this.$store.state.upadaFileNumberSum + \"个文件,已经上传\" + this.$store.state.files.length + \"个文件\";\n      }\n    }\n  },\n  methods: {\n    SuLvZhuangHuang(i) {\n      if (i < 1024) {\n        return i.toFixed(2) + \" B/s\";\n      } else if (i < 1024 * 1024) {\n        return (i / 1024).toFixed(2) + \" KB/s\";\n      } else if (i < 1024 * 1024 * 1024) {\n        return (i / (1024 * 1024)).toFixed(2) + \" MB/s\";\n      } else {\n        return (i / (1024 * 1024 * 1024)).toFixed(2) + \" GB/s\";\n      }\n    },\n    FileSize(i) {\n      if (i < 1024) {\n        return i.toFixed(2) + \" B\";\n      } else if (i < 1024 * 1024) {\n        return (i / 1024).toFixed(2) + \" KB\";\n      } else if (i < 1024 * 1024 * 1024) {\n        return (i / (1024 * 1024)).toFixed(2) + \" MB\";\n      } else {\n        return (i / (1024 * 1024 * 1024)).toFixed(2) + \" GB\";\n      }\n    }\n  }\n};","map":{"version":3,"names":["name","data","size","computed","UpdataTotal","$store","state","upadaFileNumberSum","files","length","dispatch","console","log","methods","SuLvZhuangHuang","i","toFixed","FileSize"],"sources":["E:\\桌面\\code\\restvue003\\src\\components\\Common\\VueCommon\\progressEl.vue"],"sourcesContent":["<template>\r\n  <el-table\r\n    :data=\"$store.state.files\"\r\n    style=\"width: auto\"\r\n    border\r\n    max-height=\"75vh\"\r\n  >\r\n    <el-table-column :label=\"UpdataTotal\">\r\n      <el-table-column prop=\"data\" label=\"文件名\" width=\"360vw\" align=\"center\">\r\n        <template #default=\"scope\">\r\n          <span>{{ scope.row.name }}</span>\r\n        </template>\r\n      </el-table-column>\r\n      <el-table-column\r\n        prop=\"data\"\r\n        label=\"文件大小\"\r\n        width=\"240vw\"\r\n        align=\"center\"\r\n      >\r\n        <template #default=\"scope\">\r\n          <span>{{ FileSize(scope.row.size) }}</span>\r\n        </template>\r\n      </el-table-column>\r\n      <el-table-column\r\n        prop=\"data\"\r\n        label=\"上传速度\"\r\n        width=\"240vw\"\r\n        align=\"center\"\r\n      >\r\n        <template #default=\"scope\">\r\n          <span>速度:{{ SuLvZhuangHuang(scope.row.speed) }}</span>\r\n        </template>\r\n      </el-table-column>\r\n      <el-table-column prop=\"data\" label=\"进度条\" width=\"200vw\" align=\"center\">\r\n        <template #default=\"scope\">\r\n          <el-progress\r\n            :percentage=\"Number(scope.row.progress)\"\r\n            :text-inside=\"true\"\r\n            :stroke-width=\"18\"\r\n          ></el-progress>\r\n        </template>\r\n      </el-table-column>\r\n    </el-table-column>\r\n  </el-table>\r\n  <!-- </div> -->\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: \"progressEl\",\r\n  data() {\r\n    return {\r\n      size: \"\",\r\n    };\r\n  },\r\n  computed: {\r\n    UpdataTotal() {\r\n      if (\r\n        this.$store.state.upadaFileNumberSum == this.$store.state.files.length\r\n      ) {\r\n        this.$store.dispatch(\"DirsFileList\");\r\n        return (\r\n          \"当前文件上传总数为：\" +\r\n          this.$store.state.upadaFileNumberSum +\r\n          \"个文件,已经上传\" +\r\n          this.$store.state.files.length +\r\n          \"个文件\"\r\n        );\r\n      } else {\r\n        console.log(this.$store.state.files.length,this.$store.state.upadaFileNumberSum);\r\n        \r\n        return (\r\n          \"当前文件上传总数为：\" +\r\n          this.$store.state.upadaFileNumberSum +\r\n          \"个文件,已经上传\" +\r\n          this.$store.state.files.length +\r\n          \"个文件\"\r\n        );\r\n      }\r\n    },\r\n  },\r\n  methods: {\r\n    SuLvZhuangHuang(i) {\r\n      if (i < 1024) {\r\n        return i.toFixed(2) + \" B/s\";\r\n      } else if (i < 1024 * 1024) {\r\n        return (i / 1024).toFixed(2) + \" KB/s\";\r\n      } else if (i < 1024 * 1024 * 1024) {\r\n        return (i / (1024 * 1024)).toFixed(2) + \" MB/s\";\r\n      } else {\r\n        return (i / (1024 * 1024 * 1024)).toFixed(2) + \" GB/s\";\r\n      }\r\n    },\r\n\r\n    FileSize(i) {\r\n      if (i < 1024) {\r\n        return i.toFixed(2) + \" B\";\r\n      } else if (i < 1024 * 1024) {\r\n        return (i / 1024).toFixed(2) + \" KB\";\r\n      } else if (i < 1024 * 1024 * 1024) {\r\n        return (i / (1024 * 1024)).toFixed(2) + \" MB\";\r\n      } else {\r\n        return (i / (1024 * 1024 * 1024)).toFixed(2) + \" GB\";\r\n      }\r\n    },\r\n  },\r\n};\r\n</script>\r\n"],"mappings":"AAgDA,eAAe;EACbA,IAAI,EAAE,YAAY;EAClBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,IAAI,EAAE;IACR,CAAC;EACH,CAAC;EACDC,QAAQ,EAAE;IACRC,WAAWA,CAAA,EAAG;MACZ,IACE,IAAI,CAACC,MAAM,CAACC,KAAK,CAACC,kBAAiB,IAAK,IAAI,CAACF,MAAM,CAACC,KAAK,CAACE,KAAK,CAACC,MAAK,EACrE;QACA,IAAI,CAACJ,MAAM,CAACK,QAAQ,CAAC,cAAc,CAAC;QACpC,OACE,YAAW,GACX,IAAI,CAACL,MAAM,CAACC,KAAK,CAACC,kBAAiB,GACnC,UAAS,GACT,IAAI,CAACF,MAAM,CAACC,KAAK,CAACE,KAAK,CAACC,MAAK,GAC7B,KAAI;MAER,OAAO;QACLE,OAAO,CAACC,GAAG,CAAC,IAAI,CAACP,MAAM,CAACC,KAAK,CAACE,KAAK,CAACC,MAAM,EAAC,IAAI,CAACJ,MAAM,CAACC,KAAK,CAACC,kBAAkB,CAAC;QAEhF,OACE,YAAW,GACX,IAAI,CAACF,MAAM,CAACC,KAAK,CAACC,kBAAiB,GACnC,UAAS,GACT,IAAI,CAACF,MAAM,CAACC,KAAK,CAACE,KAAK,CAACC,MAAK,GAC7B,KAAI;MAER;IACF;EACF,CAAC;EACDI,OAAO,EAAE;IACPC,eAAeA,CAACC,CAAC,EAAE;MACjB,IAAIA,CAAA,GAAI,IAAI,EAAE;QACZ,OAAOA,CAAC,CAACC,OAAO,CAAC,CAAC,IAAI,MAAM;MAC9B,OAAO,IAAID,CAAA,GAAI,IAAG,GAAI,IAAI,EAAE;QAC1B,OAAO,CAACA,CAAA,GAAI,IAAI,EAAEC,OAAO,CAAC,CAAC,IAAI,OAAO;MACxC,OAAO,IAAID,CAAA,GAAI,IAAG,GAAI,IAAG,GAAI,IAAI,E