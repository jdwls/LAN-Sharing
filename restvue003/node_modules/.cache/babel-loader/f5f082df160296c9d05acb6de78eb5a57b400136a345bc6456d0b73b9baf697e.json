{"ast":null,"code":"export default {\n  name: 'ClickShowProgress',\n  computed: {\n    Is_showProgress() {\n      const total = this.$store.state.upadaFileNumberSum;\n      const uploaded = this.$store.state.files.length;\n      return uploaded !== total - 1;\n    },\n    totalCount() {\n      return this.$store.state.upadaFileNumberSum;\n    },\n    uploadedCount() {\n      return this.$store.state.files.length;\n    }\n  },\n  methods: {\n    showProgress() {\n      this.$store.commit('setFilesTypes', '进度条');\n      this.$store.commit('setDialogVisible', true);\n    }\n  }\n};","map":{"version":3,"names":["name","computed","Is_showProgress","total","$store","state","upadaFileNumberSum","uploaded","files","length","totalCount","uploadedCount","methods","showProgress","commit"],"sources":["E:\\桌面\\code\\restvue003\\src\\components\\Common\\VueCommon\\ClickShowProgress.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <el-button @click=\"showProgress\" type=\"primary\" round v-if=\"Is_showProgress\">点击显示进度条</el-button>\r\n    <h4>当前文件上传总数为{{ totalCount }}个文件,已经上传{{ uploadedCount }}个文件</h4>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'ClickShowProgress',\r\n  computed: {\r\n    Is_showProgress() {\r\n      const total = this.$store.state.upadaFileNumberSum;\r\n      const uploaded = this.$store.state.files.length;\r\n      return uploaded !== total - 1;\r\n    },\r\n    totalCount() {\r\n      return this.$store.state.upadaFileNumberSum;\r\n    },\r\n    uploadedCount() {\r\n      return this.$store.state.files.length;\r\n    }\r\n  },\r\n  methods: {\r\n    showProgress() {\r\n      this.$store.commit('setFilesTypes', '进度条');\r\n      this.$store.commit('setDialogVisible', true);\r\n    }\r\n  }\r\n}\r\n</script>"],"mappings":"AAQA,eAAe;EACbA,IAAI,EAAE,mBAAmB;EACzBC,QAAQ,EAAE;IACRC,eAAeA,CAAA,EAAG;MAChB,MAAMC,KAAI,GAAI,IAAI,CAACC,MAAM,CAACC,KAAK,CAACC,kBAAkB;MAClD,MAAMC,QAAO,GAAI,IAAI,CAACH,MAAM,CAACC,KAAK,CAACG,KAAK,CAACC,MAAM;MAC/C