{"ast":null,"code":"import { seend_message_fun } from \"@/socke/index.js\";\nexport default {\n  name: 'Chat_Room_infomation_view',\n  data() {\n    return {\n      message: \"\"\n    };\n  },\n  computed: {\n    userStatus() {\n      if (!this.$store.state.currentChat) return {\n        type: 'info',\n        text: '未知'\n      };\n      const isOnline = this.$store.state.Online_Numbers.includes(this.$store.state.currentChat);\n      return {\n        type: isOnline ? 'success' : 'info',\n        text: isOnline ? '在线' : '离线'\n      };\n    }\n  },\n  methods: {\n    sendMessage() {\n      if (this.message && this.message.trim() !== \"\") {\n        seend_message_fun(this.message, this.$store.state.currentChat);\n        this.message = \"\";\n        this.chat_bgcolor_fun();\n      }\n      this.message = \"\";\n    },\n    chat_bgcolor_fun() {\n      const scrollTop = this.$refs.chat_bgcolor;\n      scrollTop.scrollTop = this.$refs.chat_bgcolor.scrollHeight;\n    }\n  },\n  mounted() {\n    this.$nextTick(async () => {\n      this.chat_bgcolor_fun();\n    });\n  },\n  updated() {\n    this.$nextTick(() => {\n      this.$refs.chat_bgcolor.addEventListener(\"contextmenu\", e => {\n        e.preventDefault();\n      });\n      const menu = document.querySelector('.meau');\n      var lastHighlightedElement = null;\n      this.$refs.message_text.forEach(element => {\n        element.addEventListener('contextmenu', e => {\n          e.preventDefault();\n          console.log(element);\n          if (lastHighlightedElement) {\n            lastHighlightedElement.classList.remove('gray-out');\n          }\n          // 高亮当前点击的元素\n          element.classList.add('gray-out');\n          lastHighlightedElement = element;\n          // s1=this\n          // 计算菜单位置\n          let clickX = e.pageX;\n          let clickY = e.pageY;\n          // 防止菜单超出视口\n          if (clickY + menu.offsetHeight > window.innerHeight) {\n            clickY = clickY - menu.offsetHeight;\n          }\n          if (clickX + menu.offsetWidth > window.innerWidth) {\n            clickX = clickX - menu.offsetWidth;\n          }\n          // 显示菜单\n          menu.style.display = 'flex';\n          menu.style.left = `${clickX}px`;\n          menu.style.top = `${clickY}px`;\n        });\n      });\n      document.addEventListener('click', function (e) {\n        console.log(lastHighlightedElement, 1);\n        if (menu.style.display === 'flex' && !menu.contains(e.target)) {\n          menu.style.display = 'none';\n          if (lastHighlightedElement) {\n            lastHighlightedElement.style.removeProperty('gray-out');\n            // lastHighlightedElement.classList.remove('gray-out');\n            lastHighlightedElement = null;\n          }\n        }\n      });\n    });\n  },\n  watch: {\n    '$store.state.messages_lists': {\n      handler() {\n        this.$nextTick(() => {\n          this.chat_bgcolor_fun();\n        });\n      },\n      deep: true\n    }\n  }\n};","map":{"version":3,"names":["seend_message_fun","name","data","message","computed","userStatus","$store","state","currentChat","type","text","isOnline","Online_Numbers","includes","methods","sendMessage","trim","chat_bgcolor_fun","scrollTop","$refs","chat_bgcolor","scrollHeight","mounted","$nextTick","updated","addEventListener","e","preventDefault","menu","document","querySelector","lastHighlightedElement","message_text","forEach","element","console","log","classList","remove","add","clickX","pageX","clickY","pageY","offsetHeight","window","innerHeight","offsetWidth","innerWidth","style","display","left","top","contains","target","removeProperty","watch","handler","deep"],"sources":["C:\\Users\\administered\\Desktop\\code\\restvue003\\src\\components\\ChatRoom\\Chat_Room_infomation\\Chat_Room_infomation_view.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <div class=\"chat-header card\">\r\n      <el-row align=\"middle\" :gutter=\"20\">\r\n        <el-col :span=\"2\" style=\"padding-left: 1.5vw;\">\r\n          <el-avatar :size=\"60\" src=\"https://cube.elemecdn.com/0/88/03b0d39583f48206768a7534e55bcpng.png\" />\r\n        </el-col>\r\n        <el-col :span=\"21\">\r\n          <h2 style=\"margin:0 0 0.2604vw 0;font-weight:600;color:#303133\">与 {{ $store.state.currentChat }} 的对话</h2>\r\n          <p style=\"margin:0;font-size:0.7292vw;color:#909399\">\r\n            <el-tag size=\"small\" :type=\"userStatus.type\">{{ userStatus.text }}</el-tag>\r\n          </p>\r\n        </el-col>\r\n      </el-row>\r\n      <el-divider style=\"margin:0.4vw 0\" />\r\n    </div>\r\n    <div class=\"chat-bgcolor\" ref=\"chat_bgcolor\" >\r\n      <div v-for=\"msg in $store.state.messages_lists\" :key=\"msg.id\" class=\"message-item\"\r\n        :class=\"{ 'current-user': msg.current_usrs, 'other-user': !msg.current_usrs }\">\r\n        <div class=\"message-content\">\r\n          <div class=\"message-avatar\"><el-avatar\r\n              src=\"https://cube.elemecdn.com/0/88/03b0d39583f48206768a7534e55bcpng.png\" /></div>\r\n          <div class=\"message-bubble\">\r\n            <pre class=\"message-text\" ref=\"message_text\">{{ msg.message }}</pre>\r\n            <div class=\"message-time\">{{ new Date(msg.Time * 1000).toLocaleTimeString() }}</div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n    <div class=\"message-input\">\r\n      <div class=\"ms-in\">\r\n        <el-input placeholder=\"输入消息...\" v-model=\"message\" type=\"textarea\" :autosize=\"{ minRows: 2, maxRows: 2 }\"\r\n          resize=\"none\" class=\"el-input_s\">\r\n        </el-input>\r\n      </div>\r\n\r\n      <div class=\"send_Message_css\">\r\n        <el-button @click=\"sendMessage\" type=\"primary\" size=\"large\">发送</el-button>\r\n      </div>\r\n    </div>\r\n    <div class=\"meau\">\r\n      <button>复制</button>\r\n      <button>自定义选项2</button>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { seend_message_fun } from \"@/socke/index.js\";\r\nexport default {\r\n  name: 'Chat_Room_infomation_view',\r\n  data() {\r\n    return {\r\n      message: \"\",\r\n    }\r\n  },\r\n  computed: {\r\n    userStatus() {\r\n      if (!this.$store.state.currentChat) return { type: 'info', text: '未知' };\r\n      const isOnline = this.$store.state.Online_Numbers.includes(this.$store.state.currentChat);\r\n      return {\r\n        type: isOnline ? 'success' : 'info',\r\n        text: isOnline ? '在线' : '离线'\r\n      };\r\n    },\r\n  },\r\n  methods: {\r\n    sendMessage() {\r\n      if (this.message && this.message.trim() !== \"\") {\r\n        seend_message_fun(this.message, this.$store.state.currentChat)\r\n        this.message = \"\";\r\n        this.chat_bgcolor_fun()\r\n      }\r\n      this.message = \"\";\r\n    },\r\n    chat_bgcolor_fun() {\r\n      const scrollTop = this.$refs.chat_bgcolor\r\n      scrollTop.scrollTop = this.$refs.chat_bgcolor.scrollHeight\r\n    }\r\n  },\r\n  mounted() {\r\n    this.$nextTick(async () => {\r\n      this.chat_bgcolor_fun()\r\n    })\r\n  },\r\n  updated() {\r\n    this.$nextTick(() => {\r\n      this.$refs.chat_bgcolor.addEventListener(\"contextmenu\",((e)=>{\r\n        e.preventDefault()\r\n      }))\r\n      const menu = document.querySelector('.meau');\r\n      var lastHighlightedElement = null;\r\n      this.$refs.message_text.forEach((element) => {\r\n        element.addEventListener('contextmenu', ((e) => {\r\n          e.preventDefault();\r\n          console.log(element)\r\n          if (lastHighlightedElement) {\r\n            lastHighlightedElement.classList.remove('gray-out');\r\n          }\r\n          // 高亮当前点击的元素\r\n          element.classList.add('gray-out');\r\n          lastHighlightedElement = element;\r\n          // s1=this\r\n          // 计算菜单位置\r\n          let clickX = e.pageX;\r\n          let clickY = e.pageY;\r\n          // 防止菜单超出视口\r\n          if (clickY + menu.offsetHeight > window.innerHeight) {\r\n            clickY = clickY - menu.offsetHeight;\r\n          }\r\n          if (clickX + menu.offsetWidth > window.innerWidth) {\r\n            clickX = clickX - menu.offsetWidth;\r\n          }\r\n          // 显示菜单\r\n          menu.style.display = 'flex';\r\n          menu.style.left = `${clickX}px`;\r\n          menu.style.top = `${clickY}px`;\r\n        }))\r\n      })\r\n      document.addEventListener('click', function (e) {\r\n        console.log(lastHighlightedElement,1);\r\n        \r\n            if (menu.style.display === 'flex' && !menu.contains(e.target)) {\r\n                menu.style.display = 'none';\r\n                if (lastHighlightedElement) {\r\n                  lastHighlightedElement.style.removeProperty('gray-out');\r\n                    // lastHighlightedElement.classList.remove('gray-out');\r\n                    lastHighlightedElement = null;\r\n                }\r\n            }\r\n        });\r\n    })\r\n  },\r\n  watch: {\r\n    '$store.state.messages_lists': {\r\n      handler() {\r\n        this.$nextTick(() => {\r\n          this.chat_bgcolor_fun();\r\n        });\r\n      },\r\n      deep: true\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.ms-in {\r\n  width: 65vw;\r\n}\r\n\r\n.gray-out {\r\n  background-color: #e0e0e0 !important;\r\n  color: #333 !important;\r\n}\r\n\r\n.meau {\r\n  position: absolute;\r\n  display: none;\r\n  border: 1px solid #ccc;\r\n  background: white;\r\n  flex-direction: column;\r\n  z-index: 1000;\r\n  /* 确保菜单在最上层 */\r\n}\r\n\r\n.chat-bgcolor {\r\n  height: 63vh;\r\n  background-color: #ffffff;\r\n  overflow-y: auto;\r\n  margin: 1.5vh 1vw;\r\n  border-radius: 12px;\r\n  padding: 1.5vw;\r\n  box-sizing: border-box;\r\n  display: flex;\r\n  flex-direction: column;\r\n  box-shadow: 0 0.2vw 0.8vw rgba(0, 0, 0, 0.08);\r\n  border: 1px solid #ebeef5;\r\n  flex: 1;\r\n}\r\n\r\n.message-item {\r\n  margin-bottom: 1.5vh;\r\n  display: flex;\r\n  padding: 0.5vh 0;\r\n}\r\n\r\n/* 当前用户消息样式 (右侧) */\r\n.message-item.current-user {\r\n  justify-content: flex-end;\r\n}\r\n\r\n.current-user .message-content {\r\n  flex-direction: row-reverse;\r\n}\r\n\r\n.current-user .message-bubble {\r\n  background-color: #409EFF;\r\n  color: white;\r\n  border-radius: 18px 18px 0 18px;\r\n  margin-right: 0.8vw;\r\n  box-shadow: 0 0.1vw 0.3vw rgba(0, 0, 0, 0.1);\r\n}\r\n\r\n.current-user .message-time {\r\n  color: rgba(255, 255, 255, 0.7);\r\n}\r\n\r\n/* 其他用户消息样式 (左侧) */\r\n.message-item.other-user {\r\n  justify-content: flex-start;\r\n}\r\n\r\n.other-user .message-content {\r\n  flex-direction: row;\r\n}\r\n\r\n.other-user .message-bubble {\r\n  background-color: #f5f7fa;\r\n  color: #303133;\r\n  border-radius: 18px 18px 18px 0;\r\n  margin-left: 0.8vw;\r\n  box-shadow: 0 0.1vw 0.3vw rgba(0, 0, 0, 0.08);\r\n  border: 1px solid #ebeef5;\r\n}\r\n\r\n.other-user .message-time {\r\n  color: #909399;\r\n}\r\n\r\n.message-content {\r\n  display: flex;\r\n  max-width: 30vw;\r\n}\r\n\r\n.message-avatar {\r\n  display: flex;\r\n  align-items: flex-end;\r\n}\r\n\r\n.message-bubble {\r\n  padding: 0.625vw 0.8333vw;\r\n  position: relative;\r\n  word-break: break-word;\r\n}\r\n\r\n.message-text {\r\n  margin: 0;\r\n  font-size: 0.8vw;\r\n  line-height: 1.5;\r\n  max-width: 30vw;\r\n  word-break: break-word;\r\n  overflow-wrap: break-word;\r\n  word-break: break-word;\r\n  white-space: pre-wrap;\r\n}\r\n\r\n.message-time {\r\n  font-size: 0.5vw;\r\n  margin-top: 0.2083vw;\r\n  text-align: right;\r\n}\r\n\r\n/* 输入框样式 */\r\n.el-input {\r\n  height: 6vh;\r\n  background: #ffffff;\r\n  border-radius: 20px;\r\n  box-shadow: 0 0.1042vw 0.5208vw rgba(0, 0, 0, 0.08);\r\n}\r\n\r\n.chat-header {\r\n  padding: 1.5vh 1.5vw;\r\n  background: #fff;\r\n  position: sticky;\r\n  top: 0;\r\n  z-index: 1;\r\n  box-shadow: 0 0.1vw 0.4vw rgba(0, 0, 0, 0.08);\r\n  border-radius: 12px;\r\n  margin: 1vh 1vw;\r\n  border: 1px solid #ebeef5;\r\n}\r\n\r\n.message-input {\r\n  font-family: '黑体';\r\n  display: flex;\r\n  flex-direction: column;\r\n  margin: 1.5vh 1vw;\r\n  padding: 1vw;\r\n  width: 64.9vw;\r\n  background: #ffffff;\r\n  border-radius: 12px;\r\n  box-shadow: 0 0.1vw 0.4vw rgba(0, 0, 0, 0.08);\r\n  border: 1px solid #ebeef5;\r\n  gap: 0.8vw;\r\n  /* 新增样式使容器向上拉伸 */\r\n  position: relative;\r\n  bottom: 0;\r\n  z-index: 100;\r\n}\r\n\r\n.el-textarea__inner {\r\n  resize: none;\r\n  align-items: flex-end;\r\n}\r\n\r\n:deep(.el-textarea__inner) {\r\n  box-shadow: none;\r\n  padding: 10px;\r\n  border: none;\r\n  resize: none;\r\n  font-size: 0.9vw;\r\n  /* max-height: 200px; */\r\n  /* 设置最大高度 */\r\n  overflow-y: auto;\r\n  /* 内容超出时显示滚动条 */\r\n  /* background-color: #f0f2f5; */\r\n}\r\n\r\n.send_Message_css {\r\n  align-self: flex-end\r\n}\r\n</style>\r\n"],"mappings":"AAgDA,SAASA,iBAAgB,QAAS,kBAAkB;AACpD,eAAe;EACbC,IAAI,EAAE,2BAA2B;EACjCC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,OAAO,EAAE;IACX;EACF,CAAC;EACDC,QAAQ,EAAE;IACRC,UAAUA,CAAA,EAAG;MACX,IAAI,CAAC,IAAI,CAACC,MAAM,CAACC,KAAK,CAACC,WAAW,EAAE,OAAO;QAAEC,IAAI,EAAE,MAAM;QAAEC,IAAI,EAAE;MAAK,CAAC;MACvE,MAAMC,QAAO,GAAI,IAAI,CAACL,MAAM,CAACC,KAAK,CAACK,cAAc,CAACC,QAAQ,CAAC,IAAI,CAACP,MAAM,CAACC,KAAK,CAACC,WAAW,CAAC;MACzF,OAAO;QACLC,IAAI,EAAEE,QAAO,GAAI,SAAQ,GAAI,MAAM;QACnCD,IAAI,EAAEC,QAAO,GAAI,IAAG,GAAI;MAC1B,CAAC;IACH;EACF,CAAC;EACDG,OAAO,EAAE;IACPC,WAAWA,CAAA,EAAG;MACZ,IAAI,IAAI,CAACZ,OAAM,IAAK,IAAI,CAACA,OAAO,CAACa,IAAI,CAAC,MAAM,EAAE,EAAE;QAC9ChB,iBAAiB,CAAC,IAAI,CAACG,OAAO,EAAE,IAAI,CAACG,MAAM,CAACC,KAAK,CAACC,WAAW;QAC7D,IAAI,CAACL,OAAM,GAAI,EAAE;QACjB,IAAI,CAACc,gBAAgB,CAAC;MACxB;MACA,IAAI,CAACd,OAAM,GAAI,EAAE;IACnB,CAAC;IACDc,gBAAgBA,CAAA,EAAG;MACjB,MAAMC,SAAQ,GAAI,IAAI,CAACC,KAAK,CAACC,YAAW;MACxCF,SAAS,CAACA,SAAQ,GAAI,IAAI,CAACC,KAAK,CAACC,YAAY,CAACC,YAAW;IAC3D;EACF,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,SAAS,CAAC,YAAY;MACzB,IAAI,CAACN,gBAAgB,CAAC;IACxB,CAAC;EACH,CAAC;EACDO,OAAOA,CAAA,EAAG;IACR,IAAI,CAACD,SAAS,CAAC,MAAM;MACnB,IAAI,CAACJ,KAAK,CAACC,YAAY,CAACK,gBAAgB,CAAC,aAAa,EAAGC,CAAC,IAAG;QAC3DA,CAAC,CAACC,cAAc,CAAC;MACnB,CAAE;MACF,MAAMC,IAAG,GAAIC,QAAQ,CAACC,aAAa,C